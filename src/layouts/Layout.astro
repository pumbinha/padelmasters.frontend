---
interface Props {
	title: string;
	useTransparentHeader?: boolean;
}

import "@/assets/styles/base.css";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ViewTransitions } from "astro:transitions";

const { title, useTransparentHeader = false } = Astro.props;
---

<!doctype html>
<!-- <html lang="en" class="dark"> -->
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Padel Masters" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
	</head>
	<body class={`flex min-h-screen flex-col ${useTransparentHeader || Astro.url.pathname === '/' || Astro.url.pathname === '/championships' || (Astro.url.pathname.includes('/championships/') && Astro.url.pathname.split('/').filter(Boolean).length === 3 && !Astro.url.pathname.includes('/rules')) ? 'bg-gray-900' : ''}`}>
		<Header useTransparent={useTransparentHeader || Astro.url.pathname === '/' || Astro.url.pathname === '/championships' || (Astro.url.pathname.includes('/championships/') && Astro.url.pathname.split('/').filter(Boolean).length === 3 && !Astro.url.pathname.includes('/rules'))} />
		<main class={`flex-1 ${useTransparentHeader || Astro.url.pathname === '/' || Astro.url.pathname === '/championships' || (Astro.url.pathname.includes('/championships/') && Astro.url.pathname.split('/').filter(Boolean).length === 3 && !Astro.url.pathname.includes('/rules')) ? '' : ''}`}>
			<slot />
		</main>
		<SpeedInsights />
		{!useTransparentHeader && Astro.url.pathname !== '/' && Astro.url.pathname !== '/championships' && !(Astro.url.pathname.includes('/championships/') && Astro.url.pathname.split('/').filter(Boolean).length === 3 && !Astro.url.pathname.includes('/rules')) && <Footer />}
		
		<script is:inline>
			// Global 401 error handler for the entire application
			(function() {
				// Avoid setting up multiple interceptors
				if (window.globalFetchInterceptorSetup) return;
				
				const originalFetch = window.fetch;
				window.fetch = async (...args) => {
					try {
						const response = await originalFetch(...args);
						
						// Handle 401 errors by redirecting to home page
						if (response.status === 401) {
							console.warn("Global interceptor: Token expired, redirecting to home page");
							window.location.href = "/";
							return response;
						}
						
						return response;
					} catch (error) {
						throw error;
					}
				};
				
				window.globalFetchInterceptorSetup = true;
				console.log("Global fetch interceptor setup");
			})();
		</script>
	</body>
</html>
