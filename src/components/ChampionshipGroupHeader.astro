---
import { TrophyIcon } from "@heroicons/react/24/outline";

interface Props {
	championshipId: string;
	championshipName: string;
	groupId: string;
	groupName: string;
	groupDescription?: string;
	icon?: string;
	championshipsTitle?: string;
}

const { championshipId, championshipName, groupId, groupName, groupDescription, icon = "🏆", championshipsTitle = "Championships" } = Astro.props;
---

<!-- Header Section -->
<div class="bg-white p-6 mb-1 border-b border-gray-300">
	<div class="flex items-center gap-3">
		<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[hsl(var(--page-background))] border border-gray-300">
			<TrophyIcon className="h-6 w-6 text-gray-600" />
		</div>
		<div class="flex-1">
			<div class="flex items-center gap-2 mb-1">
				<a 
					href="/championships"
					class="text-lg font-semibold text-[#1F3851] hover:text-[#152F47] transition-colors"
				>
					{championshipsTitle}
				</a>
				<span class="text-[#1F3851]">/</span>
				<a 
					href={`/championships/${championshipId}`}
					class="text-lg font-semibold text-[#1F3851] hover:text-[#152F47] transition-colors"
				>
					{championshipName}
				</a>
				<span class="text-[#1F3851]">/</span>
				<a 
					href={`/championships/${championshipId}/${groupId}/matches`}
					class="text-lg font-semibold text-[#1F3851] hover:text-[#152F47] transition-colors"
				>
					{groupName}
				</a>
			</div>
			{groupDescription && (
				<p class="text-sm text-gray-600">{groupDescription}</p>
			)}
		</div>
	</div>
</div> 