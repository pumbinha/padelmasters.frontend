		<div class="flex flex-col items-center gap-6">
			<!-- Copyright section -->
			<div class="flex flex-col items-center gap-2">
				<p class="text-sm text-neutral-400">
					© {new Date().getFullYear()} Padel Masters. All rights reserved.
				</p>
				<div class="flex items-center gap-4 text-xs text-neutral-500">
					<span>Made with ❤️ for padel lovers</span>
				</div>
			</div>
		</div>

		<!-- Bottom accent line -->
		<div class="mt-6 pt-6 border-t border-neutral-600">
			<div class="flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
				<div class="flex items-center gap-4">
					<span>🏆 Professional Tournament Management</span>
					<span>🎯 Real-time Statistics</span>
					<span>👥 Community Driven</span>
				</div>
