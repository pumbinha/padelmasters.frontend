---
type TabItem = {
	name: string;
	icon: any;
	url: string;
	isCurrent: boolean;
};

export type TabsProps = {
	tabData?: TabItem[];
};

const { tabData = [] }: TabsProps = Astro.props;
---

<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-4 shadow-2xl">
	<nav aria-label="tabs" class="flex space-x-4">
		{
			tabData.map((tab: TabItem) => (
				<a
					href={tab.url}
					aria-current={tab.isCurrent ? "page" : undefined}
					class={`group inline-flex items-center px-4 py-3 rounded-lg text-sm font-medium transition-all duration-300 ${tab.isCurrent ? "bg-white/20 border border-white/30 text-white shadow-lg" : "text-white/70 hover:text-white hover:bg-white/10 hover:border hover:border-white/20"}`}
				>
					<tab.icon
						aria-hidden="true"
						className={`${tab.isCurrent ? "text-white" : "text-white/60 group-hover:text-white/80"} -ml-0.5 mr-2 h-5 w-5`}
					/>
					<span>{tab.name}</span>
				</a>
			))
		}
	</nav>
</div>
