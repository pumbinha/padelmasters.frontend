---
import Layout from "@/layouts/Layout.astro";
import Tabs from "@/components/Tabs.astro";
import Toast from "@/components/ui/Toast";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { type ChampionshipDto, type ChampionshipDetailDto } from "@/services/api";
import { getApi, getRequestParams } from "@/services/utils";
import { 
	TrophyIcon, 
	UsersIcon, 
	CalendarDateRangeIcon, 
	CheckCircleIcon, 
	ClockIcon,
	DocumentTextIcon,
	ExclamationTriangleIcon,
	UserGroupIcon as UserGroupIconOutline,
	CalendarDaysIcon,
} from "@heroicons/react/24/outline";
import { BookOpenIcon } from "@heroicons/react/20/solid";
import { Image } from "astro:assets";
import homeNet from "@/assets/images/home-net.jpg";
import { getSession } from "auth-astro/server";

const { id } = Astro.params;

const session = await getSession(Astro.request);
const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let championship: ChampionshipDto = {};
let championshipDetail: ChampionshipDetailDto = {};

try {
	if (!id) {
		Astro.redirect("/championships/not-found");
	}

	const championshipResponse =
		await api.api.padelmastersApiDomainEndpointsChampionshipsGetChampionship(
			id || "",
			getRequestParams(session)
		);

	if (championshipResponse.ok) {
		championship = championshipResponse.data.Championship?.Championship || {};
		championshipDetail = championshipResponse.data.Championship?.ChampionshipDetail || {};
	} else {
		// 404
		Astro.redirect("/championships/not-found");
	}
} catch (e) {
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}

const tabData = [
	{
		name: t(TranslationKey.GroupsTitle),
		url: `/championships/${id}`,
		icon: UserGroupIconOutline,
		isCurrent: false,
	},
	{
		name: t(TranslationKey.RulesTitle),
		url: `/championships/${id}/rules`,
		icon: BookOpenIcon,
		isCurrent: true,
	},
];
---

<Layout title={`Championship ${championship.Name}`} useTransparentHeader={true}>
	<section class="relative w-full min-h-screen bg-gradient-to-br from-blue-900 via-blue-950 to-slate-900">
		<!-- Gradient Overlay for depth -->
		<div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/40 to-black/60"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

		<!-- Content -->
		<div class="relative z-10 pt-32 md:pt-24 px-6 pb-[26rem] md:pb-40">
			<!-- Header Section with Glassmorphism -->
			<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-6 mb-6 shadow-2xl">
				<div class="flex items-center gap-3">
					<CalendarDateRangeIcon className="h-6 w-6 text-white" />
					<div class="flex-1">
						<div class="flex items-center gap-2 mb-1">
							<h1 class="text-base sm:text-lg font-semibold text-white">
								{championship.Name}
							</h1>
						</div>
						{championship.Description && (
							<p class="text-sm text-white/80">{championship.Description}</p>
						)}
					</div>
				</div>
			</div>

			<!-- Statistics Cards (Full Width) -->
			<div class="mb-6">
				<div class="grid grid-cols-2 gap-4 md:grid-cols-4">
					<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-4 shadow-2xl hover:bg-white/15 hover:border-white/30 hover:scale-105 transition-all duration-300">
						<div class="mb-3 flex items-center gap-2">
							<UsersIcon className="h-5 w-5 text-blue-400" />
							<p class="text-xs font-semibold uppercase tracking-wide text-blue-300">
								Players
							</p>
						</div>
						<p class="text-2xl font-bold text-white">{championshipDetail.NumberEnrolledPlayers || 0}/{championshipDetail.NumberTotalPlayers || 0}</p>
					</div>
					<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-4 shadow-2xl hover:bg-white/15 hover:border-white/30 hover:scale-105 transition-all duration-300">
						<div class="mb-3 flex items-center gap-2">
							<CalendarDateRangeIcon className="h-5 w-5 text-green-400" />
							<p class="text-xs font-semibold uppercase tracking-wide text-green-300">
								Matches
							</p>
						</div>
						<p class="text-2xl font-bold text-white">{championshipDetail.NumberOfPlayedMatches || 0}/{championshipDetail.NumberMatches || 0}</p>
					</div>
					<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-4 shadow-2xl hover:bg-white/15 hover:border-white/30 hover:scale-105 transition-all duration-300">
						<div class="mb-3 flex items-center gap-2">
							<CheckCircleIcon className="h-5 w-5 text-purple-400" />
							<p class="text-xs font-semibold uppercase tracking-wide text-purple-300">
								Played
							</p>
						</div>
						<p class="text-2xl font-bold text-white">{championshipDetail.NumberOfPlayedMatches || 0}</p>
					</div>
					<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-4 shadow-2xl hover:bg-white/15 hover:border-white/30 hover:scale-105 transition-all duration-300">
						<div class="mb-3 flex items-center gap-2">
							<ClockIcon className="h-5 w-5 text-orange-400" />
							<p class="text-xs font-semibold uppercase tracking-wide text-orange-300">
								Pending
							</p>
						</div>
						<p class="text-2xl font-bold text-white">{(championshipDetail.NumberMatches || 0) - (championshipDetail.NumberOfPlayedMatches || 0)}</p>
					</div>
				</div>
			</div>

			<!-- Tabs Section (Full Width) -->
			<div class="mb-6">
				<Tabs tabData={tabData} />
			</div>
		
			<!-- Rules Content (Full Width) -->
			{
				championship.Rules && championship.Rules.length > 0 ? (
					<div>
						<!-- Rules Content -->
						<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl shadow-2xl overflow-hidden">
							<!-- Rules Body -->
							<div class="p-6">
								<!-- Additional Information Cards -->
								<div class="mb-6 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
									<!-- Tournament Format -->
									<div class="bg-white/5 backdrop-blur-sm rounded-lg border border-white/20 p-6">
										<div class="flex items-center gap-3 mb-4">
											<TrophyIcon className="h-5 w-5 text-green-400" />
											<h3 class="text-lg font-semibold text-white">Tournament Format</h3>
										</div>
										<p class="text-white/70 text-sm">
											This tournament follows standard padel rules with league format. 
											All matches are best of 3 sets with tie-break at 6-6.
										</p>
									</div>

									<!-- Schedule -->
									<div class="bg-white/5 backdrop-blur-sm rounded-lg border border-white/20 p-6">
										<div class="flex items-center gap-3 mb-4">
											<CalendarDaysIcon className="h-5 w-5 text-orange-400" />
											<h3 class="text-lg font-semibold text-white">Match Schedule</h3>
										</div>
										<p class="text-white/70 text-sm">
											Matches will be scheduled based on player availability. 
											Check the matches tab for your upcoming games.
										</p>
									</div>

									<!-- Players -->
									<div class="bg-white/5 backdrop-blur-sm rounded-lg border border-white/20 p-6">
										<div class="flex items-center gap-3 mb-4">
											<UserGroupIconOutline className="h-5 w-5 text-purple-400" />
											<h3 class="text-lg font-semibold text-white">Player Information</h3>
										</div>
										<p class="text-white/70 text-sm">
											All players must be registered and confirmed before participating. 
											Check your enrollment status in the groups section.
										</p>
									</div>
								</div>

								<!-- Tournament Rules Card -->
								<div class="bg-white/5 backdrop-blur-sm rounded-lg border border-white/20 p-6 mb-6">
									<div class="flex items-center gap-3 mb-4">
										<DocumentTextIcon className="h-5 w-5 text-blue-400" />
										<h3 class="text-lg font-semibold text-white">Tournament Rules</h3>
									</div>
									<div class="text-white/80 leading-relaxed [&_u]:no-underline [&_strong]:font-semibold [&_strong]:text-white [&_p]:mb-3 [&_p]:text-sm [&_p]:leading-relaxed [&_div]:text-sm [&_div]:leading-relaxed [&_br]:mb-2 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:space-y-2 [&_li]:text-sm [&_li]:leading-relaxed [&_li]:mb-2">
										<div set:html={championship.Rules} />
									</div>
								</div>

								<!-- Important Notes -->
								<div class="bg-yellow-400/10 border border-yellow-400/30 rounded-lg p-6 mt-6 mb-0">
									<div class="flex items-start gap-3">
										<ExclamationTriangleIcon className="h-5 w-5 text-yellow-400 mt-0.5" />
										<div>
											<h3 class="text-lg font-semibold text-yellow-300 mb-1">Important Notes</h3>
											<ul class="text-yellow-200/80 text-sm space-y-1">
												<li class="flex items-start gap-2">
													<CheckCircleIcon className="h-4 w-4 text-yellow-400 mt-0.5 flex-shrink-0" />
													<span>All players must arrive 15 minutes before their scheduled match time</span>
												</li>
												<li class="flex items-start gap-2">
													<CheckCircleIcon className="h-4 w-4 text-yellow-400 mt-0.5 flex-shrink-0" />
													<span>Proper padel attire and non-marking shoes are required</span>
												</li>
												<li class="flex items-start gap-2">
													<CheckCircleIcon className="h-4 w-4 text-yellow-400 mt-0.5 flex-shrink-0" />
													<span>Results must be reported within 24 hours of match completion</span>
												</li>
												<li class="flex items-start gap-2">
													<CheckCircleIcon className="h-4 w-4 text-yellow-400 mt-0.5 flex-shrink-0" />
													<span>Any disputes will be resolved by the tournament director</span>
												</li>
											</ul>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				) : (
					<!-- No Rules Message -->
					<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-8 text-center shadow-2xl">
						<div class="flex flex-col items-center gap-4">
							<div class="flex h-16 w-16 items-center justify-center rounded-full bg-white/20 border border-white/30">
								<DocumentTextIcon className="h-8 w-8 text-white/80" />
							</div>
							<div>
								<h3 class="text-lg font-semibold text-white mb-2">
									No rules available
								</h3>
								<p class="text-sm text-white/70">
									The tournament rules haven't been published yet. Check back later or contact the tournament organizer for more information.
								</p>
							</div>
						</div>
					</div>
				)
			}
		</div>

		<!-- Integrated Footer -->
		<footer class="absolute bottom-0 left-0 right-0 z-10 w-full">
			<div class="px-6 py-8">
				<div class="flex flex-col items-center gap-6">
					<!-- Features highlight -->
					<div class="flex flex-col md:flex-row items-center justify-center gap-6 text-center">
						<div class="flex items-center gap-2 text-white/70">
							<span>🏆</span>
							<span class="text-sm">Professional Tournament Management</span>
						</div>
						<div class="hidden md:block w-px h-4 bg-white/30"></div>
						<div class="flex items-center gap-2 text-white/70">
							<span>🎯</span>
							<span class="text-sm">Real-time Statistics</span>
						</div>
						<div class="hidden md:block w-px h-4 bg-white/30"></div>
						<div class="flex items-center gap-2 text-white/70">
							<span>👥</span>
							<span class="text-sm">Community Driven</span>
						</div>
					</div>

					<!-- Divider -->
					<div class="w-full max-w-md h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>

					<!-- Copyright -->
					<div class="flex flex-col items-center gap-2">
						<p class="text-sm text-white/60">
							© {new Date().getFullYear()} Padel Masters. All rights reserved.
						</p>
						<div class="flex items-center gap-4 text-xs text-white/50">
							<span>Made with ❤️ for padel lovers</span>
							<span>•</span>
							<span>Version 2.0</span>
						</div>
					</div>
				</div>
			</div>
		</footer>

		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
	</section>
</Layout>
