---
import Toast from "@/components/ui/Toast";
import Popup from "@/components/ui/Popup";
import ChampionshipGroupHeader from "@/components/ChampionshipGroupHeader.astro";
import { getPositionTextClass, getStandingRowClass } from "@/components/ui/utils";
import UsersLink from "@/components/UsersLink.astro";
import CountryFlag from "@/components/CountryFlag.astro";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import {
	GroupType,
	type ChampionshipDto,
	type GroupDetailDto,
	type GroupDto,
	type PlayerStandingDto,
	type GroupMatchDto,
	MatchStatus,
} from "@/services/api";
import { getApi, getRequestParams } from "@/services/utils";
import { StarIcon } from "@heroicons/react/16/solid";
import { 
	CalendarDaysIcon, 
	ChartBarIcon, 
	UsersIcon, 
	CalendarDateRangeIcon, 
	CheckCircleIcon, 
	ClockIcon,
	PlayIcon,
	XCircleIcon,
	PencilIcon
} from "@heroicons/react/24/outline";
import { getSession } from "auth-astro/server";

const { id, groupId } = Astro.params;

// Get the status filter from URL parameters
const { searchParams } = Astro.url;
const statusFilter = searchParams.get("status");

const session = await getSession(Astro.request);
const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let group: GroupDto = {};
let championship: ChampionshipDto = {};
let groupDetail: GroupDetailDto = {};
let playerStandings: PlayerStandingDto[] = [];

let matches: GroupMatchDto[] = [];
let matchCounts = {
	all: 0,
	created: 0,
	planned: 0,
	played: 0,
};

// Function to get status info
const getStatusInfo = (status: MatchStatus) => {
	switch (status) {
		case MatchStatus.Created:
			return {
				icon: PlayIcon,
				text: t("Match.Status.Created"),
				textColor: "text-gray-600",
				iconColor: "text-gray-500"
			};
		case MatchStatus.Planned:
			return {
				icon: ClockIcon,
				text: t("Match.Status.Planned"),
				textColor: "text-orange-600",
				iconColor: "text-orange-500"
			};
		case MatchStatus.Played:
			return {
				icon: CheckCircleIcon,
				text: t("Match.Status.Played"),
				textColor: "text-green-600",
				iconColor: "text-green-500"
			};
		case MatchStatus.Cancelled:
			return {
				icon: XCircleIcon,
				text: t("Match.Status.Cancelled"),
				textColor: "text-red-600",
				iconColor: "text-red-500"
			};
		default:
			return {
				icon: PlayIcon,
				text: t("Match.Status.Created"),
				textColor: "text-gray-600",
				iconColor: "text-gray-500"
			};
	}
};

// Function to get formatted date
const getFormattedDate = (dateString: string | undefined) => {
	if (!dateString) return "No date set";
	const date = new Date(dateString);
	return date.toLocaleDateString("en", {
		year: "numeric",
		month: "short",
		day: "numeric"
	});
};

try {
	if (!id) {
		Astro.redirect("/championships/not-found");
	}

	// ========= get group
	const groupResponse = await api.api.padelmastersApiDomainEndpointsGroupsGetGroup(
		groupId || "",
		getRequestParams(session)
	);

	if (groupResponse.ok) {
		group = groupResponse.data.Group?.Group || {};
		championship = groupResponse.data.Group?.Championship || {};
		groupDetail = groupResponse.data.Group?.GroupDetail || {};
	} else {
		// 404
		Astro.redirect("/group/not-found");
	}

	// ========= get matches
	if (groupDetail.NumberPlayers && groupDetail.NumberPlayers > 0) {
		const SearchMatchesRequest = {
			GroupId: groupId || "",
		};
		const matchesResponse = await api.api.padelmastersApiDomainEndpointsMatchesSearchMatches(
			SearchMatchesRequest,
			getRequestParams(session)
		);
		if (matchesResponse.ok) {
			const searchData = matchesResponse.data || [];
			matches = searchData.flatMap((group) => {
				return group.Match || [];
			});

			// Calculate match counts for each status
			const allMatches = [...matches];
			matchCounts = {
				all: allMatches.length,
				created: allMatches.filter(match => match.Status === MatchStatus.Created).length,
				planned: allMatches.filter(match => match.Status === MatchStatus.Planned).length,
				played: allMatches.filter(match => match.Status === MatchStatus.Played).length,
			};

			// Sort matches according to the specified order:
			// 1. Cancelados - at the bottom
			// 2. Creados - after cancelled
			// 3. Planificados and Jugados - by date descending (most recent first)
			matches.sort((a, b) => {
				// First, sort by status priority
				const statusPriority = {
					[MatchStatus.Cancelled]: 3, // Lowest priority (bottom)
					[MatchStatus.Created]: 2,    // Medium priority
					[MatchStatus.Planned]: 1,    // High priority
					[MatchStatus.Played]: 1,     // High priority
				};

				const aPriority = statusPriority[a.Status || MatchStatus.Created] || 2;
				const bPriority = statusPriority[b.Status || MatchStatus.Created] || 2;

				// If different status priorities, sort by priority
				if (aPriority !== bPriority) {
					return aPriority - bPriority;
				}

				// If same status priority, sort by date (descending for Planned/Played)
				if (aPriority === 1) { // Planned or Played
					const aDate = new Date(a.Date || 0);
					const bDate = new Date(b.Date || 0);
					return bDate.getTime() - aDate.getTime(); // Descending order
				}

				// For Created and Cancelled, maintain original order
				return 0;
			});
		}
	}

	// ========= get standings
	if (groupDetail.NumberPlayers && groupDetail.NumberPlayers > 0) {
		const standingsResponse = await api.api.padelmastersApiDomainEndpointsGroupsGetGroupStandings(
			groupId || "",
			getRequestParams(session)
		);
		if (standingsResponse.ok) {
			playerStandings = standingsResponse.data.PlayerStandings || [];
		} else {
			console.error("Error fetching standings:", standingsResponse);
		}
	}
} catch (e) {
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}
---

<Layout title={`Group ${group.Name}`}>
	<section class="w-full bg-[hsl(var(--page-background))] min-h-screen">
		<ChampionshipGroupHeader
			championshipId={id || ""}
			championshipName={championship.Name || ""}
			groupId={groupId || ""}
			groupName={group.Name || ""}
			groupDescription={group.Description || undefined}
		/>

		<!-- Statistics Cards -->
		<div class="p-4 mb-4">
			<div class="grid grid-cols-2 gap-6 md:grid-cols-4">
				<div class="rounded-lg bg-white p-4 border border-gray-200 shadow-sm">
					<div class="mb-2 flex items-center gap-2">
						<UsersIcon className="h-5 w-5 text-blue-600" />
						<p class="text-xs font-semibold uppercase tracking-wide text-blue-700">
							{t(TranslationKey.NumberOfPlayers)}
						</p>
					</div>
					<p class="text-2xl font-bold text-blue-800">{groupDetail.NumberPlayers}</p>
				</div>
				<div class="rounded-lg bg-white p-4 border border-gray-200 shadow-sm">
					<div class="mb-2 flex items-center gap-2">
						<CalendarDateRangeIcon className="h-5 w-5 text-green-600" />
						<p class="text-xs font-semibold uppercase tracking-wide text-green-700">
							{t(TranslationKey.NumberMatches)}
						</p>
					</div>
					<p class="text-2xl font-bold text-green-800">{groupDetail.NumberMatches}</p>
				</div>
				<div class="rounded-lg bg-white p-4 border border-gray-200 shadow-sm">
					<div class="mb-2 flex items-center gap-2">
						<CheckCircleIcon className="h-5 w-5 text-purple-600" />
						<p class="text-xs font-semibold uppercase tracking-wide text-purple-700">
							{t(TranslationKey.PlayedMatches)}
						</p>
					</div>
					<p class="text-2xl font-bold text-purple-800">
						{groupDetail.NumberOfPlayedMatches}
					</p>
				</div>
				<div class="rounded-lg bg-white p-4 border border-gray-200 shadow-sm">
					<div class="mb-2 flex items-center gap-2">
						<ClockIcon className="h-5 w-5 text-orange-600" />
						<p class="text-xs font-semibold uppercase tracking-wide text-orange-700">
							{t(TranslationKey.PendingMatches)}
						</p>
					</div>
					<p class="text-2xl font-bold text-orange-800">
						{groupDetail.NumberOfPendingMatches}
					</p>
				</div>
			</div>
		</div>

		<!-- Main Content Grid -->
		<div class="px-4">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
				<!-- Matches Section -->
				<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
					<div class="px-6 py-4 border-b border-gray-200">
						<div class="flex items-center gap-3">
							<CalendarDaysIcon className="h-5 w-5 text-blue-600" />
							<h2 class="text-lg font-semibold text-gray-900">{t(TranslationKey.MatchesTitle)}</h2>
						</div>
					</div>
										<!-- Filter Buttons -->
					<div class="px-4 py-3 border-b border-gray-200">
						<div class="flex flex-wrap gap-2">
								<button
									data-filter={MatchStatus.Planned}
									class={`inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 ${
										statusFilter === MatchStatus.Planned || !statusFilter
											? "bg-[#1F3851] text-white shadow-md"
											: "bg-gray-200 text-gray-700 hover:bg-gray-300 border border-gray-300 shadow-sm"
									}`}
								>
									{t("Match.Status.Planned")} ({matchCounts.planned})
								</button>
								<button
									data-filter={MatchStatus.Played}
									class={`inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 ${
										statusFilter === MatchStatus.Played
											? "bg-[#1F3851] text-white shadow-md"
											: "bg-gray-200 text-gray-700 hover:bg-gray-300 border border-gray-300 shadow-sm"
									}`}
								>
									{t("Match.Status.Played")} ({matchCounts.played})
								</button>
								<button
									data-filter={MatchStatus.Created}
									class={`inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 ${
										statusFilter === MatchStatus.Created
											? "bg-[#1F3851] text-white shadow-md"
											: "bg-gray-200 text-gray-700 hover:bg-gray-300 border border-gray-300 shadow-sm"
									}`}
								>
									{t("Match.Status.Created")} ({matchCounts.created})
								</button>
								<button
									data-filter="All"
									class={`inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg transition-all duration-200 ${
										statusFilter === "All"
											? "bg-[#1F3851] text-white shadow-md"
											: "bg-gray-200 text-gray-700 hover:bg-gray-300 border border-gray-300 shadow-sm"
									}`}
								>
									{t(TranslationKey.All)} ({matchCounts.all})
								</button>
							</div>
						</div>

						<!-- Matches Content -->
						<div class="p-4">
							{
							matches.length > 0 ? (
								<div id="matches-container" class="space-y-3">
									{
										matches.map((match) => {
											const statusInfo = getStatusInfo(match.Status || MatchStatus.Created);
											return (
												<div 
													data-match={match.Id}
													data-match-status={match.Status}
													class="bg-white rounded-lg border border-gray-200 shadow-sm hover:shadow-md transition-shadow"
												>
													<!-- Match Header -->
													<div class="px-4 py-3 border-b border-[hsl(var(--page-background))] bg-white rounded-t-lg">
														<div class="flex items-center justify-between">
															<!-- Left side: Status -->
															<div class="flex items-center gap-2">
																<statusInfo.icon className={`h-4 w-4 ${statusInfo.iconColor}`} />
																<span class={`text-sm font-medium ${statusInfo.textColor}`}>
																	{statusInfo.text}
																</span>
															</div>

															<!-- Right side: Actions -->
															<div class="flex items-center gap-2">
																{match.CurrentUserCanEdit && (
																	<a 
																		href={`/championships/${id}/${groupId}/matches/${match.Id}/edit`}
																		class="inline-flex items-center gap-1.5 px-3 py-2 text-xs font-medium text-[#1F3851] bg-[#1F3851]/10 border border-[#1F3851]/20 rounded-lg hover:bg-[#1F3851]/20 hover:border-[#1F3851]/30 transition-all duration-200 shadow-sm"
																		title="Edit match"
																	>
																		<PencilIcon className="h-3.5 w-3.5" />
																		<span class="hidden sm:inline">Edit</span>
																	</a>
																)}
																{match.CurrentUserCanUnplan && (
																	<Popup
																		matchAction="Unplan"
																		title={t(TranslationKey.MatchUnplanTitle)}
																		text={t(TranslationKey.MatchUnplanMessage)}
																		textActionButton={t(TranslationKey.Unplan)}
																		textCancelButton={t(TranslationKey.Cancel)}
																		matchId={match.Id || ""}
																		url={`${Astro.url.pathname}${statusFilter ? `?status=${statusFilter}` : "?status=Planned"}`}
																		client:load
																		successMessage={t(TranslationKey.MatchUnplanSuccess)}
																		errorMessage={t(TranslationKey.MatchUnplanError)}
																	/>
																)}
																{match.CurrentUserCanDelete && (
																	<Popup
																		matchAction="Delete"
																		title={t(TranslationKey.MatchRestartTitle)}
																		text={t(TranslationKey.MatchRestartMessage)}
																		textActionButton={t(TranslationKey.Restart)}
																		textCancelButton={t(TranslationKey.Cancel)}
																		matchId={match.Id || ""}
																		url={`${Astro.url.pathname}${statusFilter ? `?status=${statusFilter}` : "?status=Planned"}`}
																		client:load
																		successMessage={t(TranslationKey.MatchRestartSuccess)}
																		errorMessage={t(TranslationKey.MatchRestartError)}
																	/>
																)}
															</div>
														</div>
													</div>

													<!-- Match Content - Compact Layout -->
													<div class="p-4 border-t border-[hsl(var(--page-background))]">
														<!-- Date with Icon -->
														<div class="flex items-center gap-2 mb-3 text-sm text-gray-500">
															<CalendarDaysIcon className="h-4 w-4 text-gray-400" />
															{match.Date ? (
																<span class="text-gray-600">
																	{getFormattedDate(match.Date)}
																</span>
															) : (
																<span class="text-gray-400 italic">
																	No date set
																</span>
															)}
														</div>
														
														<div class="space-y-3">
															<!-- Team 1 Row -->
															<div class={`flex items-center justify-between p-3 rounded-lg ${match.Team1?.IsWinner ? 'bg-green-50 border border-green-200' : 'bg-gray-50 border border-gray-200'}`}>
																<!-- Team 1 Players -->
																<div class="flex items-center gap-3 flex-1">
																	<div class="flex flex-col gap-1">
																		<CountryFlag countryCode={match.Team1?.Team?.Player1?.Country || "ES"} class="w-4 h-3" />
																		<CountryFlag countryCode={match.Team1?.Team?.Player2?.Country || "ES"} class="w-4 h-3" />
																	</div>
																	<div class="flex-1 min-w-0">
																		<div class={`text-sm ${match.Team1?.IsWinner ? 'text-green-800' : 'text-gray-900'}`}>
																			<div class="flex items-center gap-2">
																				<UsersLink
																					userId={match.Team1?.Team?.Player1?.Id || ""}
																					displayName={`${match.Team1?.Team?.Player1?.FirstName} ${match.Team1?.Team?.Player1?.LastName}`}
																					class={`${match.Team1?.IsWinner ? 'text-green-800 hover:text-green-600' : 'text-gray-900 hover:text-gray-600'}`}
																				/>
																				<span class="text-xs text-gray-500">({match.Team1?.Team?.Player1?.Ranking || '-'})</span>
																			</div>
																		</div>
																		<div class={`text-sm ${match.Team1?.IsWinner ? 'text-green-700' : 'text-gray-600'}`}>
																			<div class="flex items-center gap-2">
																				<UsersLink
																					userId={match.Team1?.Team?.Player2?.Id || ""}
																					displayName={`${match.Team1?.Team?.Player2?.FirstName} ${match.Team1?.Team?.Player2?.LastName}`}
																					class={`${match.Team1?.IsWinner ? 'text-green-700 hover:text-green-600' : 'text-gray-600 hover:text-gray-500'}`}
																				/>
																				<span class="text-xs text-gray-500">({match.Team1?.Team?.Player2?.Ranking || '-'})</span>
																			</div>
																		</div>
																	</div>
																</div>

																<!-- Team 1 Results -->
																<div class="flex items-center gap-4">
																	<!-- Overall Score -->
																	<div class="text-center">
																		<span class={`text-lg font-bold ${match.Team1?.IsWinner ? 'text-green-600' : 'text-gray-600'}`}>
																			{match.MatchResults && match.MatchResults.length > 0 
																				? match.MatchResults.filter((r: any) => r && (r.ResultTeam1 || 0) > (r.ResultTeam2 || 0)).length
																				: '-'
																			}
																		</span>
																	</div>

																	<!-- Vertical Separator -->
																	<div class="w-px h-8 bg-gray-300"></div>

																	<!-- Set Scores -->
																	<div class="flex gap-3">
																		{match.MatchResults && match.MatchResults.length > 0 ? (
																			match.MatchResults.map((result: any, _index: number) => (
																				<div class="text-center">
																					<span class={`text-sm font-medium ${result && (result.ResultTeam1 || 0) > (result.ResultTeam2 || 0) ? 'text-green-600' : 'text-gray-600'}`}>
																						{result ? (result.ResultTeam1 || 0) : '-'}
																					</span>
																				</div>
																			))
																		) : (
																			// Show 3 sets with "-" for non-played matches
																			Array.from({ length: 3 }, (_, _index: number) => (
																				<div class="text-center">
																					<span class="text-sm font-medium text-gray-400">-</span>
																				</div>
																			))
																		)}
																	</div>
																</div>
															</div>

															<!-- Team 2 Row -->
															<div class={`flex items-center justify-between p-3 rounded-lg ${match.Team2?.IsWinner ? 'bg-green-50 border border-green-200' : 'bg-gray-50 border border-gray-200'}`}>
																<!-- Team 2 Players -->
																<div class="flex items-center gap-3 flex-1">
																	<div class="flex flex-col gap-1">
																		<CountryFlag countryCode={match.Team2?.Team?.Player1?.Country || "ES"} class="w-4 h-3" />
																		<CountryFlag countryCode={match.Team2?.Team?.Player2?.Country || "ES"} class="w-4 h-3" />
																	</div>
																	<div class="flex-1 min-w-0">
																		<div class={`text-sm ${match.Team2?.IsWinner ? 'text-green-800' : 'text-gray-900'}`}>
																			<div class="flex items-center gap-2">
																				<UsersLink
																					userId={match.Team2?.Team?.Player1?.Id || ""}
																					displayName={`${match.Team2?.Team?.Player1?.FirstName} ${match.Team2?.Team?.Player1?.LastName}`}
																					class={`${match.Team2?.IsWinner ? 'text-green-800 hover:text-green-600' : 'text-gray-900 hover:text-gray-600'}`}
																				/>
																				<span class="text-xs text-gray-500">({match.Team2?.Team?.Player1?.Ranking || '-'})</span>
																			</div>
																		</div>
																		<div class={`text-sm ${match.Team2?.IsWinner ? 'text-green-700' : 'text-gray-600'}`}>
																			<div class="flex items-center gap-2">
																				<UsersLink
																					userId={match.Team2?.Team?.Player2?.Id || ""}
																					displayName={`${match.Team2?.Team?.Player2?.FirstName} ${match.Team2?.Team?.Player2?.LastName}`}
																					class={`${match.Team2?.IsWinner ? 'text-green-700 hover:text-green-600' : 'text-gray-600 hover:text-gray-500'}`}
																				/>
																				<span class="text-xs text-gray-500">({match.Team2?.Team?.Player2?.Ranking || '-'})</span>
																			</div>
																		</div>
																	</div>
																</div>

																<!-- Team 2 Results -->
																<div class="flex items-center gap-4">
																	<!-- Overall Score -->
																	<div class="text-center">
																		<span class={`text-lg font-bold ${match.Team2?.IsWinner ? 'text-green-600' : 'text-gray-600'}`}>
																			{match.MatchResults && match.MatchResults.length > 0 
																				? match.MatchResults.filter((r: any) => r && (r.ResultTeam2 || 0) > (r.ResultTeam1 || 0)).length
																				: '-'
																			}
																		</span>
																	</div>

																	<!-- Vertical Separator -->
																	<div class="w-px h-8 bg-gray-300"></div>

																	<!-- Set Scores -->
																	<div class="flex gap-3">
																		{match.MatchResults && match.MatchResults.length > 0 ? (
																			match.MatchResults.map((result: any, _index: number) => (
																				<div class="text-center">
																					<span class={`text-sm font-medium ${result && (result.ResultTeam2 || 0) > (result.ResultTeam1 || 0) ? 'text-green-600' : 'text-gray-600'}`}>
																						{result ? (result.ResultTeam2 || 0) : '-'}
																					</span>
																				</div>
																			))
																		) : (
																			// Show 3 sets with "-" for non-played matches
																			Array.from({ length: 3 }, (_, _index: number) => (
																				<div class="text-center">
																					<span class="text-sm font-medium text-gray-400">-</span>
																				</div>
																			))
																		)}
																	</div>
																</div>
															</div>
														</div>
													</div>
												</div>
											);
										})
									}
								</div>
								
								<!-- No matches available message for filtered results -->
								<div id="no-matches-message" class="pt-0 pb-4" style="display: none;">
									<div class="w-full rounded-lg bg-white border border-gray-200 p-6 text-center shadow-sm">
										<div class="flex flex-col items-center gap-3">
											<div class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-100">
												<span class="text-xl">🎾</span>
											</div>
											<div>
												<h3 class="text-base font-semibold text-gray-900 mb-1">
													No matches available
												</h3>
												<p class="text-sm text-gray-500">
													No matches found with the selected filter. Try changing the filter or check back later.
												</p>
											</div>
										</div>
									</div>
								</div>
							) : (
								<div class="py-8">
									<div class="w-full rounded-lg bg-white border border-gray-200 p-8 text-center shadow-sm">
										<div class="flex flex-col items-center gap-4">
											<div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
												<span class="text-2xl">🎾</span>
											</div>
											<div>
												<h3 class="text-lg font-semibold text-gray-900 mb-2">
													No matches available
												</h3>
												<p class="text-sm text-gray-500">
													No matches found for this group. Check back later.
												</p>
											</div>
										</div>
									</div>
								</div>
							)
						}
					</div>
				</div>

				<!-- Standings Section -->
				<div class="bg-white rounded-lg border border-gray-200 shadow-sm h-fit">
					<div class="px-6 py-4 border-b border-gray-200">
						<div class="flex items-center gap-3">
							<ChartBarIcon className="h-5 w-5 text-purple-600" />
							<h2 class="text-lg font-semibold text-gray-900">{t(TranslationKey.StandingsTitle)}</h2>
						</div>
					</div>
					<div id="standings-content" class="p-4">
						{
							playerStandings.length > 0 ? (
								<div class="overflow-x-auto">
									<div class="inline-block min-w-full py-2 align-middle">
										<div class="overflow-hidden rounded-lg border border-gray-200 shadow-sm">
											<table class="min-w-full divide-y divide-gray-200">
												<thead>
													<tr class="bg-white">
														<th
															scope="col"
															class="py-4 pl-4 pr-2 text-left text-sm font-bold text-gray-700 sm:pl-6 sm:pr-3"
														>
															{t(TranslationKey.StandingsName)}
														</th>
														<th scope="col" class="px-2 py-4 text-center text-sm font-bold text-gray-700 sm:px-3">
															<div class="lg:hidden">{t(TranslationKey.StandingsPlayedShort)}</div>
															<div class="max-lg:hidden">{t(TranslationKey.StandingsPlayedLong)}</div>
														</th>
														<th scope="col" class="px-2 py-4 text-center text-sm font-bold text-gray-700 sm:px-3">
															<div class="lg:hidden">{t(TranslationKey.StandingsVictoryShort)}</div>
															<div class="max-lg:hidden">{t(TranslationKey.StandingsVictoryLong)}</div>
														</th>
														<th scope="col" class="px-2 py-4 text-center text-sm font-bold text-gray-700 sm:px-3">
															<div class="lg:hidden">{t(TranslationKey.StandingsLostShort)}</div>
															<div class="max-lg:hidden">{t(TranslationKey.StandingsLostLong)}</div>
														</th>
														<th scope="col" class="px-2 py-4 text-center text-sm font-bold text-gray-700 sm:px-3">
															<div class="lg:hidden">{t(TranslationKey.StandingsPointShort)}</div>
															<div class="max-lg:hidden">{t(TranslationKey.StandingsPointLong)}</div>
														</th>
													</tr>
												</thead>
												<tbody class="divide-y">
													{
														playerStandings.map((player, index) => (
															<tr
																class={`${getStandingRowClass(group.GroupType || GroupType.League, index, groupDetail.NumberOfFinalists)} transition-all duration-200`}
															>
																<td
																	class={`font-base whitespace-nowrap py-4 pl-4 pr-2 text-sm sm:pl-6 sm:pr-3 ${getPositionTextClass(index, groupDetail.NumberOfFinalists)}`}
																>
																	<div class="flex items-center gap-2 sm:gap-3">
																		<!-- Position -->
																		<span class="text-sm font-medium text-gray-600">{index + 1}.</span>
																		
																		<!-- Country Flag -->
																		<CountryFlag 
																			countryCode={player.User?.Country || "ES"} 
																			class="w-4 h-3" 
																		/>
																		
																		<!-- Player Name -->
																		<UsersLink
																			userId={player.User?.Id || ""}
																			displayName={`${player.User?.FirstName || ''} ${player.User?.LastName || ''}`}
																			class="text-primary-600 hover:text-primary-800 transition-colors"
																		/>
																		
																		<!-- Ranking -->
																		<span class="text-xs text-gray-500">({player.User?.Ranking || '-'})</span>
																		
																		<!-- Americano Stars -->
																		{(group.GroupType || GroupType.League) === GroupType.Americano &&
																			((index === 0 && (
																				<StarIcon
																					aria-hidden="true"
																					className="ml-auto h-4 w-4 text-yellow-400"
																				/>
																			)) ||
																				(index === 1 && (
																				<StarIcon
																					aria-hidden="true"
																					className="ml-auto h-4 w-4 text-gray-400"
																				/>
																			)) ||
																				(index === 2 && (
																				<StarIcon
																					aria-hidden="true"
																					className="ml-auto h-4 w-4 text-orange-700"
																				/>
																			)))}
																	</div>
																</td>
																<td class="whitespace-nowrap px-2 py-4 text-center align-middle text-sm font-medium text-gray-600 sm:px-3">
																	{player.PlayedMatches}
																</td>
																<td class="whitespace-nowrap px-2 py-4 text-center align-middle text-sm font-medium text-green-600 sm:px-3">
																	{player.WonMatches}
																</td>
																<td class="whitespace-nowrap px-2 py-4 text-center align-middle text-sm font-medium text-red-600 sm:px-3">
																	{player.LostMatches}
																</td>
																<td class="whitespace-nowrap px-2 py-4 text-center align-middle text-sm font-bold text-primary-600 sm:px-3">
																	{player.Points}
																</td>
															</tr>
														))
													}
												</tbody>
											</table>
										</div>
									</div>
								</div>
							) : (
								<div class="py-8">
									<div class="w-full rounded-lg bg-white border border-gray-200 p-8 text-center shadow-sm">
										<div class="flex flex-col items-center gap-4">
											<div class="flex h-16 w-16 items-center justify-center rounded-full bg-gray-100">
												<ChartBarIcon className="h-8 w-8 text-gray-400" />
											</div>
											<div>
												<h3 class="text-lg font-semibold text-gray-900 mb-2">
													No standings available
												</h3>
												<p class="text-sm text-gray-500">
													No standings found for this group. Check back later.
												</p>
											</div>
										</div>
									</div>
								</div>
							)
						}
					</div>
				</div>
			</div>
		</div>
		
		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
	</section>
</Layout><script src="/js/filtering.js" is:inline></script> 

