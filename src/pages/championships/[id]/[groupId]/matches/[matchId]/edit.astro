---
import AutoSelectInputScore from "@/components/ui/AutoSelectInputScore";
import Toast from "@/components/ui/Toast";
import ChampionshipGroupHeader from "@/components/ChampionshipGroupHeader.astro";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { isAPIError, type APIError } from "@/services/types.ts";
import {
	getApi,
	getFormattedDateForInput,
	getRequestParams,
	parseFormData,
} from "@/services/utils";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);

const t = useTranslations(session);

const { id, groupId, matchId } = Astro.params;
const searchParams = Astro.url.searchParams;
const customReturnUrl = searchParams.get("returnUrl");

let errorMessage = "";
let successMessage = "";
let championshipName = "";
let groupName = "";
let groupDescription = "";

interface EditFormData {
	matchDate: string;
	startDate: string;
	endDate: string;
	displayNameTeam1Player1: string;
	displayNameTeam1Player2: string;
	displayNameTeam2Player1: string;
	displayNameTeam2Player2: string;
	team1set1: string;
	team2set1: number;
	team1set2: number;
	team2set2: number;
	team1set3: number;
	team2set3: number;
}

let matchDate = "";
let displayNameTeam1Player1 = "";
let displayNameTeam1Player2 = "";
let displayNameTeam2Player1 = "";
let displayNameTeam2Player2 = "";
let team1set1 = 0;
let team2set1 = 0;
let team1set2 = 0;
let team2set2 = 0;
let team1set3 = 0;
let team2set3 = 0;
let startDate = "";
let endDate = "";

// Use custom return URL if provided, otherwise default to the championship group page
const returnUrl = customReturnUrl || `/championships/${id}/${groupId}`;

const api = getApi();

// Fetch championship and group data for the header
try {
	const championshipResponse = await api.api.padelmastersApiDomainEndpointsChampionshipsGetChampionship(
		id || "",
		getRequestParams(session)
	);
	if (championshipResponse.ok) {
		championshipName = championshipResponse.data?.Championship?.Championship?.Name || "";
	}

	const groupResponse = await api.api.padelmastersApiDomainEndpointsGroupsGetGroup(
		groupId || "",
		getRequestParams(session)
	);
	if (groupResponse.ok) {
		groupName = groupResponse.data?.Group?.Group?.Name || "";
		groupDescription = groupResponse.data?.Group?.Group?.Description || "";
	}
} catch (e) {
	console.error("Error fetching championship/group data:", e);
}

if (Astro.request.method === "POST") {
	try {
		const formData = await parseFormData<EditFormData>(Astro.request);

		matchDate = formData["matchDate"] || "";
		endDate = formData["endDate"] || "";
		startDate = formData["startDate"] || "";
		// Assign parsed data to your variables
		displayNameTeam1Player1 = formData["displayNameTeam1Player1"] || "";
		displayNameTeam1Player2 = formData["displayNameTeam1Player2"] || "";
		displayNameTeam2Player1 = formData["displayNameTeam2Player1"] || "";
		displayNameTeam2Player2 = formData["displayNameTeam2Player2"] || "";

		team1set1 = Number(formData["team1set1"]) || 0;
		team2set1 = Number(formData["team2set1"]) || 0;
		team1set2 = Number(formData["team1set2"]) || 0;
		team2set2 = Number(formData["team2set2"]) || 0;
		team1set3 = Number(formData["team1set3"]) || 0;
		team2set3 = Number(formData["team2set3"]) || 0;

		try {
			interface MatchResultModel {
				Date: string;
				MatchResult1?: {
					MatchSet: number;
					ResultTeam1: number;
					ResultTeam2: number;
				};
				MatchResult2?: {
					MatchSet: number;
					ResultTeam1: number;
					ResultTeam2: number;
				};
				MatchResult3?: {
					MatchSet: number;
					ResultTeam1: number;
					ResultTeam2: number;
				};
			}

			const model: MatchResultModel = {
				Date: matchDate,
			};

			if (
				team1set1 > 0 ||
				team2set1 > 0 ||
				team1set2 > 0 ||
				team2set2 > 0 ||
				team1set3 > 0 ||
				team2set3 > 0
			) {
				model.MatchResult1 = {
					MatchSet: 1,
					ResultTeam1: team1set1,
					ResultTeam2: team2set1,
				};

				model.MatchResult2 = {
					MatchSet: 2,
					ResultTeam1: team1set2,
					ResultTeam2: team2set2,
				};

				model.MatchResult3 = {
					MatchSet: 3,
					ResultTeam1: team1set3,
					ResultTeam2: team2set3,
				};

				const postMatch = await api.api.padelmastersApiDomainEndpointsMatchesSaveMatchResult(
					matchId || "",
					model,
					getRequestParams(session)
				);

				if (postMatch.ok) {
					successMessage = t(TranslationKey.MatchUpdated);
				}
			} else {
				const postMatch = await api.api.padelmastersApiDomainEndpointsMatchesPlanMatch(
					matchId || "",
					model,
					getRequestParams(session)
				);

				if (postMatch.ok) {
					successMessage = t(TranslationKey.MatchUpdated);
				}
			}
		} catch (e) {
			if (isAPIError(e)) {
				const errorAPI = e as APIError;
				errorMessage = errorAPI.error.Errors.GeneralErrors.join("\n");
			}
			console.log(e);
		}
	} catch (error) {
		console.log(error);
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}
} else if (Astro.request.method === "GET") {
	try {
		const matchResponse = await api.api.padelmastersApiDomainEndpointsMatchesGetMatch(
			matchId || "",
			getRequestParams(session)
		);
		if (matchResponse.ok) {
			const model = matchResponse.data || {};

			matchDate = getFormattedDateForInput(model.Date) || "";
			startDate = getFormattedDateForInput(model.StartDate) || "";
			endDate = getFormattedDateForInput(model.EndDate) || "";
			displayNameTeam1Player1 = `${model.Team1?.Team?.Player1?.FirstName} ${model.Team1?.Team?.Player1?.LastName}`;
			displayNameTeam1Player2 = `${model.Team1?.Team?.Player2?.FirstName} ${model.Team1?.Team?.Player2?.LastName}`;
			displayNameTeam2Player1 = `${model.Team2?.Team?.Player1?.FirstName} ${model.Team2?.Team?.Player1?.LastName}`;
			displayNameTeam2Player2 = `${model.Team2?.Team?.Player2?.FirstName} ${model.Team2?.Team?.Player2?.LastName}`;
			team1set1 = (model.MatchResults && model.MatchResults[0]?.ResultTeam1) || 0;
			team2set1 = (model.MatchResults && model.MatchResults[0]?.ResultTeam2) || 0;
			team1set2 = (model.MatchResults && model.MatchResults[1]?.ResultTeam1) || 0;
			team2set2 = (model.MatchResults && model.MatchResults[1]?.ResultTeam2) || 0;
			team1set3 = (model.MatchResults && model.MatchResults[2]?.ResultTeam1) || 0;
			team2set3 = (model.MatchResults && model.MatchResults[2]?.ResultTeam2) || 0;
		} else {
			// 404

			Astro.redirect("/not-found");
		}
	} catch (e) {
		console.log(e);
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}
}
---

<Layout title="Match Edit" useTransparentHeader={true}>
	<section class="relative w-full min-h-screen bg-gradient-to-br from-blue-900 via-blue-950 to-slate-900">
		<!-- Gradient Overlay for depth -->
		<div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/40 to-black/60"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

		<!-- Content -->
		<div class="relative z-10 pt-32 md:pt-24 px-6 pb-[26rem] md:pb-40">
			<ChampionshipGroupHeader
				championshipId={id || ""}
				championshipName={championshipName}
				groupId={groupId || ""}
				groupName={groupName}
				groupDescription={groupDescription}
			/>
		
			<div class="mx-auto max-w-2xl">
				<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl shadow-2xl">
					<form method="POST" class="p-6">
					<!-- Teams Section -->
					<div class="mb-8">
						<div class="flex items-center justify-between gap-4">
							<!-- Team 1 -->
							<div class="flex flex-col items-center space-y-3">
								<div class="text-center">
									<div class="text-sm font-semibold text-blue-300 mb-1">
										{displayNameTeam1Player1}
										<input type="hidden" name="displayNameTeam1Player1" value={displayNameTeam1Player1} />
									</div>
									<div class="text-sm font-semibold text-blue-300">
										{displayNameTeam1Player2}
										<input type="hidden" name="displayNameTeam1Player2" value={displayNameTeam1Player2} />
									</div>
								</div>
								<div class="h-1 w-16 rounded-full bg-blue-400/60"></div>
							</div>

							<!-- VS -->
							<div class="flex flex-col items-center">
								<div class="rounded-full bg-white/20 backdrop-blur-sm border border-white/30 px-4 py-2">
									<span class="text-lg font-bold text-white">VS</span>
								</div>
							</div>

							<!-- Team 2 -->
							<div class="flex flex-col items-center space-y-3">
								<div class="text-center">
									<div class="text-sm font-semibold text-red-300 mb-1">
										{displayNameTeam2Player1}
										<input type="hidden" name="displayNameTeam2Player1" value={displayNameTeam2Player1} />
									</div>
									<div class="text-sm font-semibold text-red-300">
										{displayNameTeam2Player2}
										<input type="hidden" name="displayNameTeam2Player2" value={displayNameTeam2Player2} />
									</div>
								</div>
								<div class="h-1 w-16 rounded-full bg-red-400/60"></div>
							</div>
						</div>
					</div>

					<!-- Sets Section -->
					<div class="mb-8">
						<div class="space-y-4">
							<!-- Set 1 -->
							<div class="rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 p-4">
								<div class="mb-3 text-center">
									<span class="text-sm font-medium text-white">{t(TranslationKey.Set)} 1</span>
								</div>
								<div class="flex items-center justify-between">
									<AutoSelectInputScore id="team1set1" initialValue={team1set1} client:load />
									<div class="text-2xl font-bold text-white/80">:</div>
									<AutoSelectInputScore id="team2set1" initialValue={team2set1} client:load />
								</div>
							</div>

							<!-- Set 2 -->
							<div class="rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 p-4">
								<div class="mb-3 text-center">
									<span class="text-sm font-medium text-white">{t(TranslationKey.Set)} 2</span>
								</div>
								<div class="flex items-center justify-between">
									<AutoSelectInputScore id="team1set2" initialValue={team1set2} client:load />
									<div class="text-2xl font-bold text-white/80">:</div>
									<AutoSelectInputScore id="team2set2" initialValue={team2set2} client:load />
								</div>
							</div>

							<!-- Set 3 -->
							<div class="rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 p-4">
								<div class="mb-3 text-center">
									<span class="text-sm font-medium text-white">{t(TranslationKey.Set)} 3</span>
								</div>
								<div class="flex items-center justify-between">
									<AutoSelectInputScore id="team1set3" initialValue={team1set3} client:load />
									<div class="text-2xl font-bold text-white/80">:</div>
									<AutoSelectInputScore id="team2set3" initialValue={team2set3} client:load />
								</div>
							</div>
						</div>
					</div>

					<!-- Date Section -->
					<div class="mb-8">
						<div class="rounded-xl bg-white/10 backdrop-blur-sm border border-white/20 p-4">
							<label for="matchDate" class="mb-3 block text-sm font-medium text-white">
								{t(TranslationKey.MatchDate)}
							</label>
							<input
								type="date"
								id="matchDate"
								name="matchDate"
								value={matchDate}
								min={startDate}
								max={endDate}
								required
								class="w-full rounded-lg bg-white/20 backdrop-blur-sm border border-white/30 px-4 py-3 text-white placeholder-white/60 focus:border-white/50 focus:outline-none focus:ring-2 focus:ring-white/30 date-input-glass"
							/>
							<input type="hidden" name="startDate" value={startDate} />
							<input type="hidden" name="endDate" value={endDate} />
						</div>
					</div>

					<!-- Buttons -->
					<div class="flex flex-col gap-4 sm:flex-row">
						<button
							type="submit"
							class="flex-1 px-4 py-2 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 backdrop-blur-sm border border-white/20 hover:border-white/30"
						>
							{t(TranslationKey.Save)}
						</button>
						<a
							href={`/championships/${id}/${groupId}`}
							class="flex-1 px-4 py-2 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 backdrop-blur-sm border border-white/20 hover:border-white/30 text-center"
						>
							{t(TranslationKey.Cancel)}
						</a>
					</div>
				</form>
			</div>
		</div>
		</div>

		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
		{
			successMessage && (
				<Toast message={successMessage} type="success" client:load urlRedirect={returnUrl} />
			)
		}

		<!-- Integrated Footer Section - Full Width -->
		<div class="absolute bottom-0 left-0 right-0 z-10 w-full py-6">
			<!-- Features Section -->
			<div class="flex flex-col md:flex-row items-center justify-center gap-6 mb-6 px-6">
				<div class="flex items-center gap-2 text-sm text-white/70">
					<span>🏆</span>
					<span class="hidden sm:inline">Professional Tournament Management</span>
					<span class="sm:hidden">Tournaments</span>
				</div>
				<div class="flex items-center gap-2 text-sm text-white/70">
					<span>🎯</span>
					<span class="hidden sm:inline">Real-time Statistics</span>
					<span class="sm:hidden">Statistics</span>
				</div>
				<div class="flex items-center gap-2 text-sm text-white/70">
					<span>👥</span>
					<span class="hidden sm:inline">Community Driven</span>
					<span class="sm:hidden">Community</span>
				</div>
			</div>

			<!-- Divider -->
			<div class="border-t border-white/20 mb-4 mx-6"></div>

			<!-- Bottom Section -->
			<div class="flex flex-col md:flex-row items-center justify-between gap-4 px-6">
				<!-- Copyright -->
				<div class="flex flex-col items-center md:items-start gap-2">
					<p class="text-sm text-white/70">
						© {new Date().getFullYear()} Padel Masters. All rights reserved.
					</p>
					<div class="flex items-center gap-4 text-xs text-white/60">
						<span>Made with ❤️ for padel lovers</span>
					</div>
				</div>

				<!-- Version Info -->
				<div class="flex items-center gap-2 text-xs text-white/60">
					<span>Version 2.0</span>
				</div>
			</div>
		</div>
	</section>
</Layout>

<style>
	.date-input-glass::-webkit-calendar-picker-indicator {
		filter: invert(1);
		opacity: 0.8;
	}
	
	.date-input-glass::-webkit-datetime-edit-text {
		color: white;
		opacity: 1;
	}
	
	.date-input-glass::-webkit-datetime-edit-month-field,
	.date-input-glass::-webkit-datetime-edit-day-field,
	.date-input-glass::-webkit-datetime-edit-year-field {
		color: white;
		font-weight: 600;
	}
	
	.date-input-glass::-webkit-datetime-edit-year-field {
		color: white !important;
		opacity: 1 !important;
	}
</style>

{
	successMessage && (
		<script
			is:inline
			set:html={`setTimeout(function () { window.location.href = "${returnUrl}"; }, 2000);`}
		/>
	)
}