---
import Toast from "@/components/ui/Toast";
import type { ExtendedChampionshipDto } from "@/components/ui/types";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { type ChampionshipInformationDto } from "@/services/api";
import {
	getApi,
	getFormattedDate,
	getRequestParams,
	orderChampionshipDtoByDate,
} from "@/services/utils";
import { 
	UsersIcon, 
	TrophyIcon, 
	CheckCircleIcon, 
	ClockIcon,
	PlayIcon,
	XCircleIcon,
	CalendarDaysIcon
} from "@heroicons/react/24/outline";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let championships: ExtendedChampionshipDto[] = []; // extend using UserProfile

// Function to get championship status icon and text
const getChampionshipStatusInfo = (status: string) => {
	switch (status) {
		case "Created":
			return {
				icon: PlayIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-gray-600",
				iconColor: "text-gray-500"
			};
		case "Open":
			return {
				icon: CheckCircleIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-blue-600",
				iconColor: "text-blue-500"
			};
		case "Started":
			return {
				icon: ClockIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-green-600",
				iconColor: "text-green-500"
			};
		case "Finished":
			return {
				icon: CheckCircleIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-purple-600",
				iconColor: "text-purple-500"
			};
		case "Cancelled":
			return {
				icon: XCircleIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-red-600",
				iconColor: "text-red-500"
			};
		default:
			return {
				icon: PlayIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-gray-600",
				iconColor: "text-gray-500"
			};
	}
};

try {
	const championshipResponse =
		await api.api.padelmastersApiDomainEndpointsChampionshipsGetChampionships(
			getRequestParams(session)
		);
	if (championshipResponse.ok) {
		const data: ChampionshipInformationDto[] = championshipResponse.data || [];
		data.flatMap((element: ChampionshipInformationDto) => {
			if (element.Championship) {
				championships.push({
					...element.Championship,
					...element.UserProfile,
				});
			}
		});

		championships = orderChampionshipDtoByDate(championships);
	} else {
		console.error(championshipResponse);
	}
} catch (e) {
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}
---

<Layout title="Championships">
	<section class="w-full bg-[hsl(var(--page-background))] min-h-screen">
		<!-- Header Section -->
		<div class="bg-white p-6 mb-1 border-b border-gray-300">
			<div class="flex items-center gap-3">
				<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[hsl(var(--page-background))] border border-gray-300">
					<span class="text-2xl">🏆</span>
				</div>
				<div class="flex-1">
					<div class="flex items-center gap-2 mb-1">
						<h1 class="text-lg font-semibold text-[#1F3851]">
							{t(TranslationKey.ChampionshipsTitle)}
						</h1>
					</div>
					<p class="text-sm text-gray-600">Browse and join exciting padel tournaments</p>
				</div>
			</div>
		</div>

		<!-- Championships Grid -->
		{
			championships.length === 0 ? (
				<div class="p-4">
					<div class="w-full rounded-lg bg-white border border-gray-200 p-8 text-center">
						<div class="flex flex-col items-center gap-4">
							<div class="flex h-16 w-16 items-center justify-center rounded-full bg-neutral-100">
								<span class="text-2xl">🏆</span>
							</div>
							<div>
								<h2 class="text-lg font-semibold text-gray-900">
									{t(TranslationKey.ChampionshipsNoChampionshipstitle)}
								</h2>
								<p class="mt-2 text-sm text-gray-500">{t(TranslationKey.ChampionshipsNoChampionshipsDescription)}</p>
							</div>
						</div>
					</div>
				</div>
			) : (
				<div class="p-4">
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					{
						championships.map((championship) => {
							const statusInfo = getChampionshipStatusInfo(championship.Status || "Created");
							return (
								<a
									href={`/championships/${championship.Id}`}
									class="group cursor-pointer overflow-hidden rounded-lg bg-white border border-gray-200 shadow-sm hover:shadow-md transition-all duration-200 hover:border-[#1F3851]/30"
								>
									<!-- Header similar to matches -->
									<div class="px-4 py-3 border-b border-[hsl(var(--page-background))] bg-white rounded-t-lg">
										<div class="flex items-center justify-between">
											<!-- Left side: Status and Title -->
											<div class="flex items-center gap-4">
												<!-- Status with Icon -->
												<div class="flex items-center gap-2">
													<statusInfo.icon className={`h-4 w-4 ${statusInfo.iconColor}`} />
													<span class={`text-sm font-medium ${statusInfo.textColor}`}>
														{statusInfo.text}
													</span>
												</div>

												<!-- Vertical Separator -->
												<div class="w-px h-6 bg-gray-300"></div>

												<!-- Title -->
												<div class="flex-1">
													<h2 class="text-lg font-semibold text-gray-900 group-hover:text-[#1F3851] transition-colors">
														{championship.Name}
													</h2>
												</div>
											</div>

											<!-- Right side: Enrollment status -->
											{championship.UserIsRegistered && (
												<div class="flex items-center gap-1 px-2 py-1 bg-green-50 border border-green-200 rounded-lg">
													<span class="text-xs">✅</span>
													<span class="text-xs text-green-700 font-medium">Enrolled</span>
												</div>
											)}
										</div>
									</div>

									<!-- Content similar to matches -->
									<div class="p-4 border-t border-[hsl(var(--page-background))]">
										<!-- Description -->
										<p class="text-sm text-gray-600 mb-4 line-clamp-2">
											{championship.Description}
										</p>

										<!-- Separator between description and statistics -->
										<div class="border-b border-gray-200 mb-4"></div>

										<!-- Statistics Row -->
										<div class="grid grid-cols-4 gap-4 mb-4">
											<div class="flex flex-col items-center gap-1 text-blue-600">
												<div class="flex items-center gap-2">
													<UsersIcon className="h-5 w-5" />
													<span class="text-sm font-semibold">
														{championship.NumberEnrolledPlayers || 0}/{championship.NumberTotalPlayers || 0}
													</span>
												</div>
												<span class="text-xs text-blue-600">Players</span>
											</div>
											
											<div class="flex flex-col items-center gap-1 text-green-600">
												<div class="flex items-center gap-2">
													<TrophyIcon className="h-5 w-5" />
													<span class="text-sm font-semibold">
														{championship.NumberMatches || 0}
													</span>
												</div>
												<span class="text-xs text-green-600">Matches</span>
											</div>
											
											<div class="flex flex-col items-center gap-1 text-purple-600">
												<div class="flex items-center gap-2">
													<CheckCircleIcon className="h-5 w-5" />
													<span class="text-sm font-semibold">
														{championship.NumberOfPlayedMatches || 0}
													</span>
												</div>
												<span class="text-xs text-purple-600">Played</span>
											</div>
											
											<div class="flex flex-col items-center gap-1 text-orange-600">
												<div class="flex items-center gap-2">
													<ClockIcon className="h-5 w-5" />
													<span class="text-sm font-semibold">
														{championship.NumberOfPendingMatches || 0}
													</span>
												</div>
												<span class="text-xs text-orange-600">Pending</span>
											</div>
										</div>

										<!-- Separator between statistics and progress -->
										<div class="border-b border-gray-200 mb-4"></div>

										<!-- Progress Bar -->
										<div class="mb-4">
											<div class="flex items-center justify-between mb-2">
												<span class="text-xs font-medium text-gray-600">Tournament Progress</span>
												<span class="text-xs text-gray-500">
													65%
												</span>
											</div>
											<div class="w-full bg-gray-200 rounded-full h-2">
												<div 
													class="bg-green-500 h-2 rounded-full transition-all duration-300"
													style="width: 65%"
												></div>
											</div>
										</div>

										<!-- Separator between statistics and dates -->
										<div class="border-b border-gray-200 mb-4"></div>

										<!-- Dates and Next Match Info -->
										<div class="flex items-center justify-between text-sm text-gray-600">
											<div class="flex items-center gap-2">
												<CalendarDaysIcon className="h-4 w-4 text-gray-400" />
												<span>
													{getFormattedDate(championship.StartDate, session)} - {getFormattedDate(championship.EndDate, session)}
												</span>
											</div>
											<div class="flex items-center gap-2">
												<ClockIcon className="h-4 w-4 text-gray-400" />
												<span>Next match in 3 days</span>
											</div>
										</div>
									</div>
								</a>
							);
						})
					}
					</div>
				</div>
			)
		}
		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
	</section>
</Layout>
