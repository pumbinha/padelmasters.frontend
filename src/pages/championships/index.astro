---
import Toast from "@/components/ui/Toast";
import type { ExtendedChampionshipDto } from "@/components/ui/types";
import { getStatusClass } from "@/components/ui/utils.tsx";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { type ChampionshipInformationDto } from "@/services/api";
import {
	getApi,
	getFormattedDate,
	getRequestParams,
	orderChampionshipDtoByDate,
} from "@/services/utils";
import { UserCircleIcon } from "@heroicons/react/24/solid";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let championships: ExtendedChampionshipDto[] = []; // extend using UserProfile

try {
	const championshipResponse =
		await api.api.padelmastersApiDomainEndpointsChampionshipsGetChampionships(
			getRequestParams(session)
		);
	if (championshipResponse.ok) {
		const data: ChampionshipInformationDto[] = championshipResponse.data || [];
		data.flatMap((element: ChampionshipInformationDto) => {
			if (element.Championship) {
				championships.push({
					...element.Championship,
					...element.UserProfile,
				});
			}
		});

		championships = orderChampionshipDtoByDate(championships);
	} else {
		console.error(championshipResponse);
	}
} catch (e) {
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}
---

<Layout title="Championships">
	<section class="w-full bg-[hsl(var(--page-background))] min-h-screen">
		<!-- Header Section -->
		<div class="bg-primary-200 p-6 mb-4 border-b border-primary-800">
			<div class="flex items-center gap-3">
				<div class="flex h-10 w-10 items-center justify-center rounded-lg bg-primary-200">
					<span class="text-lg">🏆</span>
				</div>
				<div>
					<h1 class="text-2xl font-bold text-primary-800">
						{t(TranslationKey.ChampionshipsTitle)}
					</h1>
					<p class="text-sm text-primary-600 mt-1">#Browse and join exciting padel tournaments</p>
				</div>
			</div>
		</div>

		<!-- Championships Grid -->
		{
			championships.length === 0 ? (
				<div class="w-full rounded-lg bg-white border border-gray-200 p-8 text-center">
					<div class="flex flex-col items-center gap-4">
						<div class="flex h-16 w-16 items-center justify-center rounded-full bg-neutral-100">
							<span class="text-2xl">🏆</span>
						</div>
						<div>
							<h2 class="text-lg font-semibold text-gray-900">
								{t(TranslationKey.ChampionshipsNoChampionshipstitle)}
							</h2>
							<p class="mt-2 text-sm text-gray-500">{t(TranslationKey.ChampionshipsNoChampionshipsDescription)}</p>
						</div>
					</div>
				</div>
			) : (
				<div class="px-4 sm:px-6 lg:px-8 mb-8">
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					{
						championships.map((championship) => {
							return (
								<a
									href={`/championships/${championship.Id}`}
									class="championship-card group cursor-pointer overflow-hidden rounded-lg bg-gray-50 border border-gray-400 transition-all duration-200 hover:bg-gray-100 hover:border-primary-600 block"
									onclick={`console.log('Clicking championship: ${championship.Id}'); return true;`}
								>
									<!-- Header with status -->
									<div class="p-2 border-b border-gray-400">
										<div class="flex items-start justify-between mb-3">
											<h2 class="text-lg font-bold text-gray-900 group-hover:text-primary-700 transition-colors">
												{championship.Name}
											</h2>
											{championship.UserIsRegistered && (
												<div class="flex items-center gap-1">
													<UserCircleIcon className="h-5 w-5 text-primary-600" />
													<span class="text-xs text-primary-600 font-medium">#Enrolled</span>
												</div>
											)}
										</div>
										
										<p class="text-sm text-gray-600 mb-3 line-clamp-2">
											{championship.Description}
										</p>
										
										<div class="flex items-center justify-between mb-3">
											<span
												class={`rounded-lg px-3 py-1 text-xs font-medium ${getStatusClass(championship.Status)}`}
											>
												{t(`Championships.Status.${championship.Status}`)}
											</span>
										</div>
									</div>

									<!-- Dates and details -->
									<div class="p-4">
										<div class="grid grid-cols-2 gap-3">
											<div class="group-hover:bg-gray-100 bg-gray-50 rounded-lg p-3 transition-colors duration-200">
												<div class="flex items-center gap-2 mb-1">
													<span class="text-xs">📅</span>
													<span class="text-xs font-medium uppercase tracking-wide text-gray-600">
														{t(TranslationKey.ChampionshipsStartDate)}
													</span>
												</div>
												<span class="text-sm font-semibold text-gray-700">
													{getFormattedDate(championship.StartDate, session)}
												</span>
											</div>
											
											<div class="group-hover:bg-gray-100 bg-gray-50 rounded-lg p-3 transition-colors duration-200">
												<div class="flex items-center gap-2 mb-1">
													<span class="text-xs">🏁</span>
													<span class="text-xs font-medium uppercase tracking-wide text-gray-600">
														{t(TranslationKey.ChampionshipsEndDate)}
													</span>
												</div>
												<span class="text-sm font-semibold text-gray-700">
													{getFormattedDate(championship.EndDate, session)}
												</span>
											</div>
										</div>
									</div>
								</a>
							);
						})
					}
					</div>
				</div>
			)
		}
		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
	</section>
</Layout>
