---
import Toast from "@/components/ui/Toast";
import type { ExtendedChampionshipDto } from "@/components/ui/types";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { type ChampionshipInformationDto } from "@/services/api";
import {
	getApi,
	getFormattedDate,
	getRequestParams,
	orderChampionshipDtoByDate,
	AuthenticationError,
} from "@/services/utils";
import { 
	UsersIcon, 
	TrophyIcon, 
	CheckCircleIcon, 
	ClockIcon,
	PlayIcon,
	XCircleIcon,
	CalendarDaysIcon,
	CalendarDateRangeIcon
} from "@heroicons/react/24/outline";
import { getSession } from "auth-astro/server";

// Get the status filter from URL parameters
const { searchParams } = Astro.url;
const statusFilter = searchParams.get("status") || "Started"; // Default to Started

const session = await getSession(Astro.request);
const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let championships: ExtendedChampionshipDto[] = []; // extend using UserProfile
let championshipCounts = {
	started: 0,
	finished: 0,
	open: 0,
	created: 0,
	cancelled: 0
};

// Function to get championship status icon and text
const getChampionshipStatusInfo = (status: string) => {
	switch (status) {
		case "Created":
			return {
				icon: PlayIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-gray-600",
				iconColor: "text-gray-500"
			};
		case "Open":
			return {
				icon: CheckCircleIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-blue-600",
				iconColor: "text-blue-500"
			};
		case "Started":
			return {
				icon: ClockIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-green-600",
				iconColor: "text-green-500"
			};
		case "Finished":
			return {
				icon: CheckCircleIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-purple-600",
				iconColor: "text-purple-500"
			};
		case "Cancelled":
			return {
				icon: XCircleIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-red-600",
				iconColor: "text-red-500"
			};
		default:
			return {
				icon: PlayIcon,
				text: t(`Championships.Status.${status}`),
				textColor: "text-gray-600",
				iconColor: "text-gray-500"
			};
	}
};

try {
	const championshipResponse =
		await api.api.padelmastersApiDomainEndpointsChampionshipsGetChampionships(
			getRequestParams(session)
		);
	if (championshipResponse.ok) {
		const data: ChampionshipInformationDto[] = championshipResponse.data || [];
		data.flatMap((element: ChampionshipInformationDto) => {
			if (element.Championship) {
				championships.push({
					...element.Championship,
					...element.UserProfile,
				});
			}
		});

		championships = orderChampionshipDtoByDate(championships);
		
		// Calculate counts for each status BEFORE filtering
		championshipCounts = {
			started: championships.filter(c => c.Status === "Started").length,
			finished: championships.filter(c => c.Status === "Finished").length,
			open: championships.filter(c => c.Status === "Open").length,
			created: championships.filter(c => c.Status === "Created").length,
			cancelled: championships.filter(c => c.Status === "Cancelled").length
		};
		
		// Don't filter server-side, we'll filter client-side with JavaScript
	} else {
		console.error(championshipResponse);
	}
} catch (e) {
	if (e instanceof AuthenticationError) {
		// Authentication failed, redirect to home page
		return Astro.redirect("/");
	}
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}
---

<Layout title="Championships">
	<section class="relative w-full min-h-screen bg-gradient-to-br from-blue-900 via-blue-950 to-slate-900">
		<!-- Gradient Overlay for depth -->
		<div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/40 to-black/60"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

		<!-- Content -->
		<div class="relative z-10 pt-32 md:pt-24 px-6 pb-[26rem] md:pb-40">
			<!-- Header Section with Glassmorphism -->
			<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-6 mb-6 shadow-2xl">
				<div class="flex items-center gap-3">
					<TrophyIcon className="h-6 w-6 text-white" />
					<div class="flex-1">
						<div class="flex items-center gap-2 mb-1">
							<h1 class="text-base sm:text-lg font-semibold text-white">
								{t(TranslationKey.ChampionshipsTitle)}
							</h1>
						</div>
						<p class="text-sm text-white/80">Browse and join exciting padel tournaments</p>
					</div>
				</div>
			</div>

			<!-- Status Filter Tabs -->
			<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl mb-6 shadow-2xl">
				<div class="px-4 py-3 border-b border-white/20">
					<div class="flex flex-wrap gap-2">
						<button
							data-filter="Started"
							class={`inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-200 backdrop-blur-sm ${
								statusFilter === "Started"
									? "bg-white/60 text-black border-white/70 shadow-xl font-semibold"
									: "bg-white/10 text-white/80 hover:bg-white/20 border-white/20 shadow-sm"
							}`}
						>
							<ClockIcon className="w-3 h-3 mr-1" />
							En Curso ({championshipCounts.started})
						</button>
						<button
							data-filter="Finished"
							class={`inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-200 backdrop-blur-sm ${
								statusFilter === "Finished"
									? "bg-white/60 text-black border-white/70 shadow-xl font-semibold"
									: "bg-white/10 text-white/80 hover:bg-white/20 border-white/20 shadow-sm"
							}`}
						>
							<TrophyIcon className="w-3 h-3 mr-1" />
							Finalizados ({championshipCounts.finished})
						</button>
						<button
							data-filter="Open"
							class={`inline-flex items-center px-3 py-1.5 text-xs font-medium rounded-lg border transition-all duration-200 backdrop-blur-sm ${
								statusFilter === "Open"
									? "bg-white/60 text-black border-white/70 shadow-xl font-semibold"
									: "bg-white/10 text-white/80 hover:bg-white/20 border-white/20 shadow-sm"
							}`}
						>
							<CheckCircleIcon className="w-3 h-3 mr-1" />
							Abiertos ({championshipCounts.open})
						</button>
					</div>
				</div>
			</div>

			<!-- Championships Container -->
			<div class="max-w-7xl mx-auto">
				<!-- No Championships Message (hidden by default, shown by JS when needed) -->
				<div id="no-championships-message" class="w-full p-8 text-center" style="display: none;">
					<div class="flex flex-col items-center gap-4">
						<TrophyIcon className="h-16 w-16 text-white/60" />
						<div>
							<h2 class="text-lg font-semibold text-white" id="no-championships-title">
								No hay campeonatos disponibles
							</h2>
							<p class="mt-2 text-sm text-white/70">
								Actualmente no hay campeonatos con el estado solicitado. Prueba con otro filtro.
							</p>
						</div>
					</div>
				</div>

				<!-- Championships Grid -->
				{
					championships.length === 0 ? (
						<div class="w-full p-8 text-center">
							<div class="flex flex-col items-center gap-4">
								<TrophyIcon className="h-16 w-16 text-white/60" />
								<div>
									<h2 class="text-lg font-semibold text-white">
										{t(TranslationKey.ChampionshipsNoChampionshipstitle)}
									</h2>
									<p class="mt-2 text-sm text-white/70">{t(TranslationKey.ChampionshipsNoChampionshipsDescription)}</p>
								</div>
							</div>
						</div>
				) : (
					<div id="championships-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
					{
						championships.map((championship) => {
							const statusInfo = getChampionshipStatusInfo(championship.Status || "Created");
							return (
								<a
									href={`/championships/${championship.Id}`}
									class="group cursor-pointer overflow-hidden rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-2xl hover:bg-white/15 hover:border-white/30 transition-all duration-300 hover:scale-105"
									data-championship-status={championship.Status || "Created"}
								>
									<!-- Header similar to matches -->
									<div class="px-4 py-3 border-b border-white/20 bg-white/5 rounded-t-xl">
										<div class="flex items-center justify-between">
											<!-- Left side: Status and Title -->
											<div class="flex items-center gap-4">
												<!-- Status with Icon -->
												<div class="flex items-center gap-2">
													<statusInfo.icon className="h-4 w-4 text-white/90" />
													<span class="text-sm font-medium text-white/90">
														{statusInfo.text}
													</span>
												</div>

												<!-- Vertical Separator -->
												<div class="w-px h-6 bg-white/30"></div>

												<!-- Title -->
												<div class="flex-1">
													<h2 class="text-lg font-semibold text-white group-hover:text-blue-200 transition-colors">
														{championship.Name}
													</h2>
												</div>
											</div>

											<!-- Right side: Enrollment status -->
											{championship.UserIsRegistered && (
												<div class="flex items-center gap-1 px-2 py-1 bg-green-500/20 border border-green-400/30 rounded-lg backdrop-blur-sm">
													<span class="text-xs">✅</span>
													<span class="text-xs text-green-200 font-medium">Enrolled</span>
												</div>
											)}
										</div>
									</div>

									<!-- Content similar to matches -->
									<div class="p-4 border-t border-white/20">
										<!-- Description -->
										<p class="text-sm text-white/80 mb-4 line-clamp-2">
											{championship.Description}
										</p>

										<!-- Separator between description and statistics -->
										<div class="border-b border-white/20 mb-4"></div>

										<!-- Statistics Row -->
										<div class="grid grid-cols-4 gap-4 mb-4">
											<div class="flex flex-col items-center gap-1">
												<div class="flex items-center gap-2">
													<UsersIcon className="h-5 w-5 text-blue-400" />
													<span class="text-sm font-semibold text-white">
														{championship.NumberEnrolledPlayers || 0}/{championship.NumberTotalPlayers || 0}
													</span>
												</div>
												<span class="text-xs text-blue-300">Players</span>
											</div>
											
											<div class="flex flex-col items-center gap-1">
												<div class="flex items-center gap-2">
													<CalendarDateRangeIcon className="h-5 w-5 text-green-400" />
													<span class="text-sm font-semibold text-white">
														{championship.NumberMatches || 0}
													</span>
												</div>
												<span class="text-xs text-green-300">Matches</span>
											</div>
											
											<div class="flex flex-col items-center gap-1">
												<div class="flex items-center gap-2">
													<CheckCircleIcon className="h-5 w-5 text-purple-400" />
													<span class="text-sm font-semibold text-white">
														{championship.NumberOfPlayedMatches || 0}
													</span>
												</div>
												<span class="text-xs text-purple-300">Played</span>
											</div>
											
											<div class="flex flex-col items-center gap-1">
												<div class="flex items-center gap-2">
													<ClockIcon className="h-5 w-5 text-orange-400" />
													<span class="text-sm font-semibold text-white">
														{championship.NumberOfPendingMatches || 0}
													</span>
												</div>
												<span class="text-xs text-orange-300">Pending</span>
											</div>
										</div>

										<!-- Separator between statistics and progress -->
										<div class="border-b border-white/20 mb-4"></div>

										<!-- Progress Bar -->
										<div class="mb-4">
											<div class="flex items-center justify-between mb-2">
												<span class="text-xs font-medium text-white/80">Tournament Progress</span>
												<span class="text-xs text-white/70">
													65%
												</span>
											</div>
											<div class="w-full bg-white/20 rounded-full h-2">
												<div 
													class="bg-green-400 h-2 rounded-full transition-all duration-300"
													style="width: 65%"
												></div>
											</div>
										</div>

										<!-- Separator between statistics and dates -->
										<div class="border-b border-white/20 mb-4"></div>

										<!-- Dates and Next Match Info -->
										<div class="flex items-center justify-between text-sm text-white/80">
											<div class="flex items-center gap-2">
												<CalendarDaysIcon className="h-4 w-4 text-white/60" />
												<span>
													{getFormattedDate(championship.StartDate, session)} - {getFormattedDate(championship.EndDate, session)}
												</span>
											</div>
											<div class="flex items-center gap-2">
												<ClockIcon className="h-4 w-4 text-white/60" />
												<span>Next match in 3 days</span>
											</div>
										</div>
									</div>
								</a>
							);
						})
					}
					</div>
				)
			}
			{errorMessage && <Toast message={errorMessage} type="error" client:load />}
			</div>
		</div>

		<!-- Integrated Footer Section - Full Width -->
		<div class="absolute bottom-0 left-0 right-0 z-10 w-full py-6">
			<!-- Features Section -->
			<div class="flex flex-col md:flex-row items-center justify-center gap-6 mb-6 px-6">
				<div class="flex items-center gap-2 text-sm text-white/70">
					<span>🏆</span>
					<span class="hidden sm:inline">Professional Tournament Management</span>
					<span class="sm:hidden">Tournaments</span>
				</div>
				<div class="flex items-center gap-2 text-sm text-white/70">
					<span>🎯</span>
					<span class="hidden sm:inline">Real-time Statistics</span>
					<span class="sm:hidden">Statistics</span>
				</div>
				<div class="flex items-center gap-2 text-sm text-white/70">
					<span>👥</span>
					<span class="hidden sm:inline">Community Driven</span>
					<span class="sm:hidden">Community</span>
				</div>
			</div>

			<!-- Divider -->
			<div class="border-t border-white/20 mb-4 mx-6"></div>

			<!-- Bottom Section -->
			<div class="flex flex-col md:flex-row items-center justify-between gap-4 px-6">
				<!-- Copyright -->
				<div class="flex flex-col items-center md:items-start gap-2">
					<p class="text-sm text-white/70">
						© {new Date().getFullYear()} Padel Masters. All rights reserved.
					</p>
					<div class="flex items-center gap-4 text-xs text-white/60">
						<span>Made with ❤️ for padel lovers</span>
					</div>
				</div>

				<!-- Version Info -->
				<div class="flex items-center gap-2 text-xs text-white/60">
					<span>Version 2.0</span>
				</div>
			</div>
		</div>
	</section>

	<script>
		function initializeFiltering() {
			const filterButtons = document.querySelectorAll("[data-filter]");
			const championshipsGrid = document.getElementById("championships-grid");
			const noChampionshipsMessage = document.getElementById("no-championships-message");
			const noChampionshipsTitle = document.getElementById("no-championships-title");
			
			if (!filterButtons.length || !championshipsGrid) return;
			
			// Remove old event listeners by cloning buttons
			filterButtons.forEach((button) => {
				const newButton = button.cloneNode(true);
				button.parentNode?.replaceChild(newButton, button);
			});
			
			// Get fresh references after cloning
			const freshFilterButtons = document.querySelectorAll("[data-filter]");
			
			freshFilterButtons.forEach((button) => {
				button.addEventListener("click", function (e) {
					e.preventDefault();
					const target = e.currentTarget as HTMLElement;
					if (!target) return;
					
					const filter = target.getAttribute("data-filter");
					if (!filter) return;
					
					// Update active button
					freshFilterButtons.forEach((btn) => {
						if (btn) {
							(btn as HTMLElement).classList.remove(
								"bg-white/60",
								"text-black", 
								"border-white/70",
								"shadow-xl",
								"font-semibold"
							);
							(btn as HTMLElement).classList.add(
								"bg-white/10",
								"text-white/80",
								"hover:bg-white/20",
								"border-white/20",
								"shadow-sm"
							);
						}
					});
					
					// Set active button
					target.classList.remove(
						"bg-white/10",
						"text-white/80",
						"hover:bg-white/20", 
						"border-white/20",
						"shadow-sm"
					);
					target.classList.add(
						"bg-white/60",
						"text-black",
						"border-white/70", 
						"shadow-xl",
						"font-semibold"
					);
					
					// Filter championships
					const championshipElements = championshipsGrid.querySelectorAll("[data-championship-status]");
					let visibleCount = 0;
					
					championshipElements.forEach((championshipElement) => {
						const championshipStatus = championshipElement.getAttribute("data-championship-status");
						const isVisible = championshipStatus === filter;
						const element = championshipElement as HTMLElement;
						
						if (isVisible) {
							element.style.display = "block";
							visibleCount++;
						} else {
							element.style.display = "none";
						}
					});
					
					// Show/hide no championships message
					if (visibleCount === 0) {
						championshipsGrid.style.display = "none";
						noChampionshipsMessage!.style.display = "block";
						
						// Update message based on filter
						const messages = {
							"Started": "No hay campeonatos en curso",
							"Finished": "No hay campeonatos finalizados", 
							"Open": "No hay campeonatos abiertos"
						};
						if (noChampionshipsTitle) {
							noChampionshipsTitle.textContent = messages[filter as keyof typeof messages] || "No hay campeonatos disponibles";
						}
					} else {
						championshipsGrid.style.display = "grid";
						noChampionshipsMessage!.style.display = "none";
					}
					
					// Update URL without reloading
					const url = new URL(window.location.href);
					url.searchParams.set("status", filter);
					window.history.pushState({}, "", url);
				});
			});
			
			// Set initial filter based on URL or default to 'Started'
			const urlParams = new URLSearchParams(window.location.search);
			const initialFilter = urlParams.get("status") || "Started";
			
			// Find and click the appropriate button
			const initialButton = Array.from(freshFilterButtons).find(
				(btn) => btn.getAttribute("data-filter") === initialFilter
			) as HTMLElement;
			
			if (initialButton) {
				initialButton.click();
			}
		}
		
		// Initialize filtering on page load and Astro transitions
		document.addEventListener("DOMContentLoaded", initializeFiltering);
		document.addEventListener("astro:page-load", initializeFiltering);
	</script>
</Layout>
