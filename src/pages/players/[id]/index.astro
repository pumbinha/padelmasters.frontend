---
import Tabs from "@/components/Tabs.astro";
import MatchEditLink from "@/components/ui/MatchEditLink";
import Popup from "@/components/ui/Popup";
import Toast from "@/components/ui/Toast";
import { getMatchStatusClass, getWinnerLoserSetClass } from "@/components/ui/utils";
import UsersLink from "@/components/UsersLink.astro";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import PlayerHeader from "@/sections/PlayerHeader.astro";
import {
	type GroupMatchDto,
	type UserDto,
	type UserStatisticsDto,
	MatchStatus,
} from "@/services/api";
import {
	getApi,
	getFormattedDate,
	getRequestParams,
	orderGroupMatchSearchDtoByDate,
} from "@/services/utils";
import { CalendarDaysIcon, ChartBarIcon } from "@heroicons/react/24/outline";
import { getSession } from "auth-astro/server";

const { id } = Astro.params;
// Get the status filter from URL parameters
const { searchParams } = Astro.url;
const statusFilter = searchParams.get("status");

const session = await getSession(Astro.request);
const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let user: UserDto = {};
let userStatistics: UserStatisticsDto = {};
let userMatches: GroupMatchDto[] = [];

try {
	if (!id) {
		Astro.redirect("/championships/not-found");
	}

	const userResponse = await api.api.padelmastersApiDomainEndpointsUsersGetUser(
		id || "",
		getRequestParams(session)
	);

	if (userResponse.ok) {
		user = userResponse.data.User || {};
		userStatistics = userResponse.data.UserStatistics || {};
		userMatches = userResponse.data.UserMatches || [];
		userMatches = orderGroupMatchSearchDtoByDate(userMatches);

		// Filter matches if a status filter is provided
		if (statusFilter && statusFilter !== "All") {
			userMatches = userMatches.filter((match) => match.Status === statusFilter);
		}
	} else {
		// 404
		Astro.redirect("/championships/not-found");
	}
} catch (e) {
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}

const tabData = [
	{
		name: t(TranslationKey.MatchesTitle),
		url: `/players/${id}`,
		icon: CalendarDaysIcon,
		isCurrent: true,
	},
	{
		name: t(TranslationKey.RankingTitle),
		url: `/players/${id}/ranking`,
		icon: ChartBarIcon,
		isCurrent: false,
	},
];
---

<Layout title=`Player - ${user.FirstName} ${user.LastName} `>
	<section class="w-full bg-[hsl(var(--page-background))] min-h-screen">
		<PlayerHeader user={user} userStatistics={userStatistics} />
		<Tabs tabData={tabData} />
		<div class="p-4">
			<div class="mb-6">
				<div class="flex items-center justify-between">
					<div class="flex flex-wrap gap-2">
						<a
							href={Astro.url.pathname}
							class={`inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium transition-all duration-200 hover:shadow-md ${
								!statusFilter || statusFilter === "All"
									? "bg-primary-600 text-white shadow-sm"
									: "bg-gray-100 text-gray-700 hover:bg-gray-200"
							}`}
						>
							{t(TranslationKey.All)}
						</a>
						<a
							href={`${Astro.url.pathname}?status=${MatchStatus.Created}`}
							class={`inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium transition-all duration-200 hover:shadow-md ${
								statusFilter === MatchStatus.Created
									? "bg-primary-600 text-white shadow-sm"
									: "bg-gray-100 text-gray-700 hover:bg-gray-200"
							}`}
						>
							{t("Match.Status.Created")}
						</a>
						<a
							href={`${Astro.url.pathname}?status=${MatchStatus.Planned}`}
							class={`inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium transition-all duration-200 hover:shadow-md ${
								statusFilter === MatchStatus.Planned
									? "bg-primary-600 text-white shadow-sm"
									: "bg-gray-100 text-gray-700 hover:bg-gray-200"
							}`}
						>
							{t("Match.Status.Planned")}
						</a>
						<a
							href={`${Astro.url.pathname}?status=${MatchStatus.Played}`}
							class={`inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium transition-all duration-200 hover:shadow-md ${
								statusFilter === MatchStatus.Played
									? "bg-primary-600 text-white shadow-sm"
									: "bg-gray-100 text-gray-700 hover:bg-gray-200"
							}`}
						>
							{t("Match.Status.Played")}
						</a>
						<a
							href={`${Astro.url.pathname}?status=${MatchStatus.Cancelled}`}
							class={`inline-flex items-center rounded-full px-3 py-1.5 text-xs font-medium transition-all duration-200 hover:shadow-md ${
								statusFilter === MatchStatus.Cancelled
									? "bg-primary-600 text-white shadow-sm"
									: "bg-gray-100 text-gray-700 hover:bg-gray-200"
							}`}
						>
							{t("Match.Status.Cancelled")}
						</a>
					</div>
				</div>
				<!-- Visual separator line -->
				<div class="mt-4 border-b border-gray-200"></div>
			</div>

			<div
				class="inline-block min-w-full divide-y py-2 align-middle sm:px-6 lg:px-8"
				id="matchesContainer"
			>
				{
					userMatches.map((match) => (
						<div class="py-4">
							<div>
								<div>
									<span
										class={`rounded-lg px-2 py-1 text-xs font-medium ${getMatchStatusClass(match.Status)}`}
									>
										{t(`Match.Status.${match.Status}`)}
									</span>
									<span class="ml-4 text-xs font-light text-neutral-500">
										{getFormattedDate(match.Date, session)}
									</span>

									<span class="float-right ml-4 text-xs font-light text-neutral-500">
										{match.CurrentUserCanDelete && (
											<Popup
												matchAction="Delete"
												title={t(TranslationKey.MatchRestartTitle)}
												text={t(TranslationKey.MatchRestartMessage)}
												textActionButton={t(TranslationKey.Restart)}
												textCancelButton={t(TranslationKey.Cancel)}
												matchId={match.Id || ""}
												url={`/players/${id}${statusFilter ? `?status=${statusFilter}` : ""}`}
												client:load
												successMessage={t(TranslationKey.MatchRestartSuccess)}
												errorMessage={t(TranslationKey.MatchRestartError)}
											/>
										)}
									</span>
									<span class="float-right ml-4 text-xs font-light text-neutral-500">
										{match.CurrentUserCanUnplan && (
											<Popup
												matchAction="Unplan"
												title={t(TranslationKey.MatchUnplanTitle)}
												text={t(TranslationKey.MatchUnplanMessage)}
												textActionButton={t(TranslationKey.Unplan)}
												textCancelButton={t(TranslationKey.Cancel)}
												matchId={match.Id || ""}
												url={`/players/${id}${statusFilter ? `?status=${statusFilter}` : ""}`}
												client:load
												successMessage={t(TranslationKey.MatchUnplanSuccess)}
												errorMessage={t(TranslationKey.MatchUnplanError)}
											/>
										)}
									</span>
									<span class="float-right ml-4 text-xs font-light text-neutral-500">
										{match.CurrentUserCanEdit && (
											<MatchEditLink
												matchId={match.Id || ""}
												returnUrl={`/players/${id}${statusFilter ? `?status=${statusFilter}` : ""}`}
												client:load
											/>
										)}
									</span>
								</div>
							</div>
							<div>
								<table class="min-w-full">
									<thead>
										<tr>
											<th
												scope="col"
												class="pl-4 pr-3 text-left text-sm font-medium text-gray-900 sm:pl-0"
											/>

											{match.MatchResults?.map(() => {
												return (
													<th class="w-1 px-3 text-right text-sm font-semibold text-gray-900" />
												);
											})}
										</tr>
									</thead>
									<tbody>
										<tr>
											<td
												class={`font-base whitespace-nowrap py-4 pl-4 pr-3 text-sm ${match.Team1?.IsWinner ? "font-semibold text-primary-600 hover:text-primary-400" : "text-gray-900"}`}
											>
												<UsersLink
													userId={match.Team1?.Team?.Player1?.Id || ""}
													displayName={`${match.Team1?.Team?.Player1?.FirstName} ${match.Team1?.Team?.Player1?.LastName}`}
													class={`${match.Team1?.Team?.Player1?.Id === id ? "font-semibold text-primary-600 hover:text-primary-400" : "text-gray-900"}`}
												/>

												<br />
												<UsersLink
													userId={match.Team1?.Team?.Player2?.Id || ""}
													displayName={`${match.Team1?.Team?.Player2?.FirstName} ${match.Team1?.Team?.Player2?.LastName}`}
													class={`${match.Team1?.Team?.Player2?.Id === id ? "font-semibold text-primary-600 hover:text-primary-400" : "text-gray-900"}`}
												/>
											</td>

											{match.MatchResults?.map((result) => {
												return (
													<td class={`${getWinnerLoserSetClass(1, result)} border-b-2`}>
														{result ? result.ResultTeam1 : ""}
													</td>
												);
											})}
										</tr>
										<tr>
											<td
												class={`font-base whitespace-normal py-4 pb-2 pl-4 pr-3 text-sm ${match.Team2?.IsWinner ? "text-primary-600" : "text-gray-900"}`}
											>
												<UsersLink
													userId={match.Team2?.Team?.Player1?.Id || ""}
													displayName={`${match.Team2?.Team?.Player1?.FirstName} ${match.Team2?.Team?.Player1?.LastName}`}
													class={`${match.Team2?.Team?.Player1?.Id === id ? "font-semibold text-primary-600 hover:text-primary-400" : "text-gray-900"}`}
												/>

												<br />
												<UsersLink
													userId={match.Team2?.Team?.Player2?.Id || ""}
													displayName={`${match.Team2?.Team?.Player2?.FirstName} ${match.Team2?.Team?.Player2?.LastName}`}
													class={`${match.Team2?.Team?.Player2?.Id === id ? "font-semibold text-primary-600 hover:text-primary-400" : "text-gray-900"}`}
												/>
											</td>

											{match.MatchResults?.map((result) => {
												return (
													<td class={`${getWinnerLoserSetClass(2, result)} `}>
														{result ? result.ResultTeam2 : ""}
													</td>
												);
											})}
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					))
				}

				{
					userMatches.length === 0 && (
						<div class="py-4 text-center text-gray-500">{t(TranslationKey.NoMatchesFound)}</div>
					)
				}
			</div>
		</div>
		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
	</section>
</Layout>
