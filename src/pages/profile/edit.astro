---
import Toast from "@/components/ui/Toast";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations, getCountries } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { parseFormData, getApi, getRequestParams, AuthenticationError } from "@/services/utils";
import { UserIcon } from "@heroicons/react/24/outline";
import { getSession } from "auth-astro/server";
import type { UserProfileDto, UpdateUserProfileRequest } from "@/services/api";

const session = await getSession(Astro.request);
const t = useTranslations(session);
const countries = getCountries(session);
const issuerUrl = import.meta.env.KEYCLOAK_ISSUER;
const api = getApi();

const errors = { firstName: "", lastName: "" };
interface EditFormData {
	firstName: string;
	lastName: string;
	email: string;
	locale: string;
	country: string;
	enableEmailNotifications: string | undefined; // HTML checkbox sends "on" or undefined
}

let firstName: string = "";
let lastName: string = "";
let email: string = "";
let locale: string = "";
let country: string = "";
let locales: string[] = [];
let enableEmailNotifications: boolean = false;
let createdAt: string = "";
let hasExternalAccount: boolean = true;

let errorMessage = "";
let successMessage = "";

if (Astro.request.method === "POST") {
	try {
		const formData = await parseFormData<EditFormData>(Astro.request);

		// Assign parsed data to your variables
		firstName = formData["firstName"] || "";
		lastName = formData["lastName"] || "";
		email = formData.email || "";
		locale = formData.locale || "";
		country = formData.country || "";
		// Convert checkbox value: "on" -> true, undefined/null -> false
		enableEmailNotifications = formData.enableEmailNotifications === "on";

		// validation
		if (typeof firstName !== "string" || firstName.length < 1) {
			errors.firstName += "Please enter a firstName. ";
		}

		if (typeof lastName !== "string" || lastName.length < 1) {
			errors.lastName += "Please enter a lastName. ";
		}

		const localeUrl = `${issuerUrl}/account/supportedLocales`;

		try {
			const response = await fetch(`${localeUrl}`, {
				method: "get",
				headers: {
					"Content-Type": "application/json",
					"Authorization": `Bearer ${session?.access_token}`,
				},
			});

			await response.json().then((data) => {
				locales = data;
			});
		} catch (e) {
			// Error loading data
			errorMessage = t(TranslationKey.ErrorLoadingData);
		}

		// Prepare data for new API endpoint
		const requestData: UpdateUserProfileRequest = {
			FirstName: firstName,
			LastName: lastName,
			Alias: null, // Not used in current form
			EnableEmailNotifications: enableEmailNotifications,
			Locale: locale,
			Country: country,
		};

		try {
			const updateResponse = await api.api.padelmastersApiDomainEndpointsUsersUpdateUserProfile(
				requestData,
				getRequestParams(session)
			);

			if (updateResponse.ok) {
				console.log("✅ Profile update successful");
				successMessage = t(TranslationKey.ProfileUpdatedSuccessfully);
			} else {
				console.error("❌ Profile update failed:");
				console.error("Status:", updateResponse.status);
				console.error("Response:", updateResponse);
				errorMessage = t(TranslationKey.ErrorLoadingData);
			}
		} catch (e) {
			if (e instanceof AuthenticationError) {
				return Astro.redirect("/");
			}
			console.error("❌ Profile update exception:");
			console.error("Error object:", e);
			console.error("Error type:", typeof e);
			console.error("Error message:", e instanceof Error ? e.message : String(e));
			if (e && typeof e === 'object' && 'data' in e) {
				console.error("Error data:", (e as any).data);
			}
			errorMessage = t(TranslationKey.ErrorLoadingData);
		}
	} catch (error) {
		if (error instanceof Error) {
			console.error(error.message);
		}
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}
} else if (Astro.request.method === "GET") {
	//Fetch user data

	if (!session) {
		Astro.redirect("/");
	}

	try {
		const userProfileResponse = await api.api.padelmastersApiDomainEndpointsUsersGetUserProfile(
			getRequestParams(session)
		);

		if (userProfileResponse.ok && userProfileResponse.data) {
			const profileData: UserProfileDto = userProfileResponse.data;
			firstName = profileData.FirstName || "";
			lastName = profileData.LastName || "";
			email = profileData.Email || "";
			locale = profileData.Locale || "";
			country = profileData.Country || "";
			enableEmailNotifications = profileData.EnableEmailNotifications || false;
			createdAt = profileData.CreatedAt || "";
			hasExternalAccount = profileData.HasExternalAccount ?? true;
		} else {
			errorMessage = t(TranslationKey.ErrorLoadingData);
		}
	} catch (e) {
		if (e instanceof AuthenticationError) {
			return Astro.redirect("/");
		}
		console.error(e);
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}

	const localeUrl = `${issuerUrl}/account/supportedLocales`;

	try {
		const response = await fetch(`${localeUrl}`, {
			method: "get",
			headers: {
				"Content-Type": "application/json",
				"Authorization": `Bearer ${session?.access_token}`,
			},
		});

		await response.json().then((data) => {
			locales = data;
		});
	} catch (e) {
		// Error loading data
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}
}
---

<Layout title="Profile Edit" useTransparentHeader>
	<section class="relative w-full min-h-screen bg-gradient-to-br from-blue-900 via-blue-950 to-slate-900">
		<!-- Gradient Overlay for depth -->
		<div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/40 to-black/60"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

		<!-- Content -->
		<div class="relative z-10 pt-32 md:pt-24 px-6 pb-[26rem] md:pb-40">
			<!-- Header Section with Glassmorphism -->
			<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-6 mb-6 shadow-2xl">
				<div class="flex items-center gap-3">
					<UserIcon className="h-6 w-6 text-white" />
					<div class="flex-1">
						<div class="flex items-center gap-2 mb-1">
							<a 
								href="/profile"
								class="text-lg font-semibold text-blue-300 hover:text-blue-200 transition-colors underline decoration-blue-400/30 hover:decoration-blue-300/50"
							>
								Profile
							</a>
							<span class="text-white/40">/</span>
							<h1 class="text-lg font-semibold text-white">
								{t(TranslationKey.ProfileTitleEdit)}
							</h1>
						</div>
						<p class="text-sm text-white/80">Edit your personal information and account settings</p>
					</div>
				</div>
			</div>

			<!-- Form Section -->
			<div class="max-w-2xl mx-auto">
				<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl shadow-2xl">
					<form method="POST" class="p-6">
						<div class="space-y-6">
							<!-- Personal Information Section -->
							<div>
								<h3 class="text-lg font-medium text-white mb-4">Personal Information</h3>
								
								<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
									<div>
										<label class="block text-sm font-medium text-white/90 mb-2">
											{t(TranslationKey.ProfileFirstName)}
										</label>
										<input
											required
											id="firstName"
											name="firstName"
											type="text"
											class="w-full rounded-lg border border-white/20 bg-white/10 backdrop-blur-sm px-3 py-2 text-sm text-white placeholder:text-white/50 focus:border-white/40 focus:ring-1 focus:ring-white/40 transition-all"
											value={firstName}
										/>
									</div>

									<div>
										<label class="block text-sm font-medium text-white/90 mb-2">
											{t(TranslationKey.ProfileLastName)}
										</label>
										<input
											required
											id="lastName"
											name="lastName"
											type="text"
											class="w-full rounded-lg border border-white/20 bg-white/10 backdrop-blur-sm px-3 py-2 text-sm text-white placeholder:text-white/50 focus:border-white/40 focus:ring-1 focus:ring-white/40 transition-all"
											value={lastName}
										/>
									</div>

									<div>
										<label class="block text-sm font-medium text-white/90 mb-2">
											{t(TranslationKey.ProfileCountry)}
										</label>
										<div class="relative">
											<select
												id="country"
												name="country"
												class="w-full rounded-lg border border-white/20 bg-white/10 backdrop-blur-sm pl-10 pr-8 py-2 text-sm text-white focus:border-white/40 focus:ring-1 focus:ring-white/40 transition-all appearance-none"
											>
												{
													countries.map((countryOption) => {
														return (
															<option 
																value={countryOption.value} 
																selected={countryOption.value === country}
																data-flag={countryOption.value}
															>
																{countryOption.name}
															</option>
														);
													})
												}
											</select>
											<!-- Flag icon container -->
											<div class="absolute left-3 top-1/2 transform -translate-y-1/2 pointer-events-none">
												{country && <span class={`fi fi-${country} w-4 h-3 inline-block`}></span>}
												{!country && <span class="w-4 h-3 inline-block text-white/50">🌍</span>}
											</div>
											<!-- Dropdown arrow -->
											<div class="absolute right-3 top-1/2 transform -translate-y-1/2 pointer-events-none">
												<svg class="w-3 h-3 text-white/60" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
													<path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
												</svg>
											</div>
										</div>
									</div>
								</div>
							</div>

							<!-- Separator -->
							<div class="border-b border-white/20"></div>

							<!-- Account Information Section -->
							<div>
								<h3 class="text-lg font-medium text-white mb-4">Account Information</h3>
								
								<div class="space-y-4">
									<!-- Email and Member Since Row -->
									<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
										<!-- Email Address -->
										<div>
											<label class="block text-sm font-medium text-white/90 mb-2">
												{t(TranslationKey.ProfileEmailAddress)}
											</label>
											<div class="rounded-lg border border-white/10 bg-white/5 backdrop-blur-sm px-3 py-2">
												<p class="text-sm text-white/80">{email || "No email provided"}</p>
											</div>
										</div>

										<!-- Account Created Date -->
										<div>
											<label class="block text-sm font-medium text-white/90 mb-2">
												Member Since
											</label>
											<div class="rounded-lg border border-white/10 bg-white/5 backdrop-blur-sm px-3 py-2">
												<p class="text-sm text-white/80">
													{createdAt ? new Date(createdAt).toLocaleDateString(locale || 'en-US', {
														year: 'numeric',
														month: '2-digit',
														day: '2-digit'
													}) : "Date not available"}
												</p>
											</div>
										</div>
									</div>

									<!-- Email Notifications -->
									<div>
										<label class="flex items-center gap-3 cursor-pointer">
											<input
												id="enableEmailNotifications"
												name="enableEmailNotifications"
												type="checkbox"
												class="rounded border-white/20 bg-white/10 text-blue-400 focus:ring-blue-400 focus:ring-offset-0 h-4 w-4"
												checked={enableEmailNotifications}
											/>
											<span class="text-sm font-medium text-white/90">
												Receive email notifications
											</span>
										</label>
										<p class="mt-1 text-xs text-white/70">
											Get notified about tournament updates, match schedules, and important announcements
										</p>
									</div>

									<!-- Locale Selection -->
									<div>
										<label class="block text-sm font-medium text-white/90 mb-2">
											{t(TranslationKey.ProfileSelectALocale)}
										</label>
										<select
											id="locale"
											name="locale"
											class="w-full rounded-lg border border-white/20 bg-white/10 backdrop-blur-sm px-3 py-2 text-sm text-white focus:border-white/40 focus:ring-1 focus:ring-white/40 transition-all"
										>
											{
												locales.map((element: string) => {
													return (
														<option value={element} selected={element === locale}>
															{element.toUpperCase()}
														</option>
													);
												})
											}
										</select>
									</div>

									<!-- Change Password Link (only for non-external accounts) -->
									{!hasExternalAccount && (
										<div class="pt-2 border-t border-white/10">
											<a
												href="/profile/change-password"
												class="inline-flex items-center gap-2 text-sm text-blue-300 hover:text-blue-200 transition-colors underline decoration-blue-400/30 hover:decoration-blue-300/50"
											>
												<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
													<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v-2l-4.257-4.257A6 6 0 0111 6h2" />
												</svg>
												Change Password
											</a>
											<p class="mt-1 text-xs text-white/60">
												Update your account password for enhanced security
											</p>
										</div>
									)}
								</div>
							</div>
						</div>

						<!-- Buttons -->
						<div class="flex gap-4 mt-8 pt-6 border-t border-white/20">
							<button
								type="submit"
								class="flex-1 px-4 py-2 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 backdrop-blur-sm border border-white/20 hover:border-white/30"
								id="profile-save-btn"
							>
								{t(TranslationKey.Save)}
							</button>
							<a
								href="/profile"
								class="flex-1 px-4 py-2 rounded-lg text-white/90 hover:text-white hover:bg-white/10 transition-all duration-200 backdrop-blur-sm border border-white/20 hover:border-white/30 text-center"
							>
								{t(TranslationKey.Cancel)}
							</a>
						</div>
					</form>
				</div>
			</div>
		</div>

		<!-- Integrated Footer Section - Full Width -->
		<div class="absolute bottom-0 left-0 right-0 z-10 w-full py-6">

			<!-- Bottom Section -->
			<div class="flex flex-col md:flex-row items-center justify-between gap-4 px-6">
				<!-- Copyright -->
				<div class="flex flex-col items-center md:items-start gap-2">
					<p class="text-sm text-white/70">
						© {new Date().getFullYear()} Padel Masters. All rights reserved.
					</p>
					<div class="flex items-center gap-4 text-xs text-white/60">
						<span>Made with ❤️ for padel lovers</span>
					</div>
				</div>

				<!-- Version Info -->
				<div class="flex items-center gap-2 text-xs text-white/60">
					<span>Version 2.0</span>
				</div>
			</div>
		</div>

		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
		{
			successMessage && (
				<Toast message={successMessage} type="success" urlRedirect="/profile" client:load />
			)
		}
	</section>

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			const countrySelect = document.getElementById('country') as HTMLSelectElement;
			const flagContainer = countrySelect?.parentElement?.querySelector('div:first-of-type span');
			
			if (countrySelect && flagContainer) {
				countrySelect.addEventListener('change', function() {
					const selectedValue = this.value;
					
					if (selectedValue) {
						flagContainer.className = `fi fi-${selectedValue} w-4 h-3 inline-block`;
						flagContainer.textContent = '';
					} else {
						flagContainer.className = 'w-4 h-3 inline-block text-white/50';
						flagContainer.textContent = '🌍';
					}
				});
			}

			// Add form submit logging
			const form = document.querySelector('form') as HTMLFormElement;
			if (form) {
				form.addEventListener('submit', function(e) {
					console.log('=== CLIENT-SIDE FORM SUBMIT DEBUG ===');
					
					const formData = new FormData(form);
					const formObject: any = {};
					
					for (const [key, value] of formData.entries()) {
						formObject[key] = value;
					}
					
					console.log('Form Data Object:', formObject);
					
					// Simulate the API request data structure
					const apiRequestData = {
						FirstName: formData.get('firstName'),
						LastName: formData.get('lastName'),
						Alias: null,
						EnableEmailNotifications: formData.get('enableEmailNotifications') === 'on',
						Locale: formData.get('locale'),
						Country: formData.get('country')
					};
					
					console.log('API Request Data (what will be sent):', JSON.stringify(apiRequestData, null, 2));
					console.log('=====================================');
				});
			}
		});

		// Reinitialize script after ViewTransitions navigation
		document.addEventListener('astro:after-swap', function() {
			const countrySelect = document.getElementById('country') as HTMLSelectElement;
			const flagContainer = countrySelect?.parentElement?.querySelector('div:first-of-type span');
			
			if (countrySelect && flagContainer) {
				countrySelect.addEventListener('change', function() {
					const selectedValue = this.value;
					
					if (selectedValue) {
						flagContainer.className = `fi fi-${selectedValue} w-4 h-3 inline-block`;
						flagContainer.textContent = '';
					} else {
						flagContainer.className = 'w-4 h-3 inline-block text-white/50';
						flagContainer.textContent = '🌍';
					}
				});
			}

			// Re-add form submit logging after navigation
			const form = document.querySelector('form') as HTMLFormElement;
			if (form) {
				form.addEventListener('submit', function(e) {
					console.log('=== CLIENT-SIDE FORM SUBMIT DEBUG (after navigation) ===');
					
					const formData = new FormData(form);
					const formObject: any = {};
					
					for (const [key, value] of formData.entries()) {
						formObject[key] = value;
					}
					
					console.log('Form Data Object:', formObject);
					
					const apiRequestData = {
						FirstName: formData.get('firstName'),
						LastName: formData.get('lastName'),
						Alias: null,
						EnableEmailNotifications: formData.get('enableEmailNotifications') === 'on',
						Locale: formData.get('locale'),
						Country: formData.get('country')
					};
					
					console.log('API Request Data (what will be sent):', JSON.stringify(apiRequestData, null, 2));
					console.log('========================================================');
				});
			}
		});
	</script>
</Layout>
