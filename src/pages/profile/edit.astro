---
import Toast from "@/components/ui/Toast";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import Layout from "@/layouts/Layout.astro";
import { parseFormData } from "@/services/utils";
import { getSession } from "auth-astro/server";

const session = await getSession(Astro.request);
const t = useTranslations(session);
const issuerUrl = import.meta.env.KEYCLOAK_ISSUER;
const accountUrl = `${issuerUrl}/account`;

const errors = { firstName: "", lastName: "", username: "" };
interface EditFormData {
	firstName: string;
	lastName: string;
	username: string;
	email: string;
	locale: string;
}

let firstName: string = "";
let lastName: string = "";
let email: string = "";
let username: string = "";
let locale: string = "";
let locales: string[] = [];

let errorMessage = "";
let successMessage = "";

if (Astro.request.method === "POST") {
	try {
		const formData = await parseFormData<EditFormData>(Astro.request);

		// Assign parsed data to your variables
		firstName = formData["firstName"] || "";
		lastName = formData["lastName"] || "";
		email = formData.email || "";
		username = formData.username || "";
		locale = formData.locale || "";

		// validation
		if (typeof firstName !== "string" || firstName.length < 1) {
			errors.firstName += "Please enter a firstName. ";
		}

		if (typeof lastName !== "string" || lastName.length < 1) {
			errors.lastName += "Please enter a lastName. ";
		}
		if (typeof username !== "string" || username.length < 1) {
			errors.username += "Please enter a username. ";
		}

		const localeUrl = `${issuerUrl}/account/supportedLocales`;

		try {
			const response = await fetch(`${localeUrl}`, {
				method: "get",
				headers: {
					"Content-Type": "application/json",
					"Authorization": `Bearer ${session?.access_token}`,
				},
			});

			await response.json().then((data) => {
				locales = data;
			});
		} catch (e) {
			console.log(e);
			errorMessage = t(TranslationKey.ErrorLoadingData);
		}

		const data = {
			firstName: firstName,
			lastName: lastName,
			username: username,
			email: email,
			attributes: {
				locale: [locale],
			},
		};
		try {
			const response = await fetch(`${accountUrl}`, {
				method: "POST",
				headers: {
					"Content-Type": "application/json",
					"Authorization": `Bearer ${session?.access_token}`,
				},
				body: JSON.stringify(data),
			});

			if (response.ok) {
				successMessage = t(TranslationKey.ProfileUpdatedSuccessfully);
			}
		} catch (e) {
			console.log(e);
			errorMessage = t(TranslationKey.ErrorLoadingData);
		}
	} catch (error) {
		if (error instanceof Error) {
			console.error(error.message);
		}
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}
} else if (Astro.request.method === "GET") {
	//Fetch user data

	if (!session) {
		Astro.redirect("/sign-in");
	}

	try {
		const response = await fetch(`${accountUrl}`, {
			method: "get",
			headers: {
				"Content-Type": "application/json",
				"Authorization": `Bearer ${session?.access_token}`,
			},
		});

		await response.json().then((data) => {
			firstName = data.firstName;
			lastName = data.lastName;
			email = data.email;
			username = data.username;
			locale = data.attributes.locale[0];
		});
	} catch (e) {
		console.log(e);
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}

	const localeUrl = `${issuerUrl}/account/supportedLocales`;

	try {
		const response = await fetch(`${localeUrl}`, {
			method: "get",
			headers: {
				"Content-Type": "application/json",
				"Authorization": `Bearer ${session?.access_token}`,
			},
		});

		await response.json().then((data) => {
			locales = data;
		});
	} catch (e) {
		console.log(e);
		errorMessage = t(TranslationKey.ErrorLoadingData);
	}
}
---

<Layout title="Profile Edit">
	<section class="w-full bg-[hsl(var(--page-background))] min-h-screen">
		<!-- Header Section -->
		<div class="bg-white p-6 mb-1 border-b border-gray-300">
			<div class="flex items-center gap-3">
				<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-[hsl(var(--page-background))] border border-gray-300">
					<span class="text-2xl">👤</span>
				</div>
				<div class="flex-1">
					<div class="flex items-center gap-2 mb-1">
						<a 
							href="/profile"
							class="text-lg font-semibold text-[#1F3851] hover:text-[#152F47] transition-colors"
						>
							Profile
						</a>
						<span class="text-[#1F3851]">/</span>
						<h1 class="text-lg font-semibold text-[#1F3851]">
							{t(TranslationKey.ProfileTitleEdit)}
						</h1>
					</div>
					<p class="text-sm text-gray-600">Edit your personal information and account settings</p>
				</div>
			</div>
		</div>

		<!-- Form Section -->
		<div class="p-4">
			<div class="max-w-2xl mx-auto">
				<div class="bg-white rounded-lg border border-gray-200 shadow-sm">
					<form method="POST" class="p-6">
						<div class="space-y-6">
							<!-- Personal Information Section -->
							<div>
								<h3 class="text-lg font-medium text-gray-900 mb-4">Personal Information</h3>
								
								<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
									<div>
										<label class="block text-sm font-medium text-gray-700 mb-2">
											{t(TranslationKey.ProfileFirstName)}
										</label>
										<input
											required
											id="firstName"
											name="firstName"
											type="text"
											class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-[#1F3851] focus:ring-1 focus:ring-[#1F3851] transition-colors"
											value={firstName}
										/>
									</div>

									<div>
										<label class="block text-sm font-medium text-gray-700 mb-2">
											{t(TranslationKey.ProfileLastName)}
										</label>
										<input
											required
											id="lastName"
											name="lastName"
											type="text"
											class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 placeholder:text-gray-400 focus:border-[#1F3851] focus:ring-1 focus:ring-[#1F3851] transition-colors"
											value={lastName}
										/>
									</div>
								</div>
							</div>

							<!-- Account Information Section -->
							<div>
								<h3 class="text-lg font-medium text-gray-900 mb-4">Account Information</h3>
								
								<div class="space-y-4">
									<div>
										<label class="block text-sm font-medium text-gray-700 mb-2">
											{t(TranslationKey.ProfileUsername)}
										</label>
										<input
											readonly
											id="username"
											name="username"
											type="text"
											class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-500 bg-gray-50 cursor-not-allowed"
											value={username}
										/>
									</div>

									<div>
										<label class="block text-sm font-medium text-gray-700 mb-2">
											{t(TranslationKey.ProfileEmailAddress)}
										</label>
										<input
											readonly
											id="email"
											name="email"
											type="email"
											class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-500 bg-gray-50 cursor-not-allowed"
											value={email}
										/>
									</div>

									<div>
										<label class="block text-sm font-medium text-gray-700 mb-2">
											{t(TranslationKey.ProfileSelectALocale)}
										</label>
										<select
											id="locale"
											name="locale"
											class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 focus:border-[#1F3851] focus:ring-1 focus:ring-[#1F3851] transition-colors"
										>
											{
												locales.map((element: string) => {
													return (
														<option value={element} selected={element === locale}>
															{element.toUpperCase()}
														</option>
													);
												})
											}
										</select>
									</div>
								</div>
							</div>
						</div>

						<!-- Buttons -->
						<div class="flex items-center justify-end gap-4 mt-8 pt-6 border-t border-gray-200">
							<a
								href="/profile"
								class="px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-colors"
							>
								{t(TranslationKey.Cancel)}
							</a>
							<button
								type="submit"
								class="px-4 py-2 text-sm font-medium text-white bg-[#1F3851] border border-transparent rounded-lg hover:bg-[#152F47] focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-[#1F3851] transition-colors"
							>
								{t(TranslationKey.Save)}
							</button>
						</div>
					</form>
				</div>
			</div>
		</div>

		{errorMessage && <Toast message={errorMessage} type="error" client:load />}
		{
			successMessage && (
				<Toast message={successMessage} type="success" urlRedirect="/profile" client:load />
			)
		}
	</section>
</Layout>
