---
import SignOutComponent from "@/components/ui/SignOut.tsx";
import Toast from "@/components/ui/Toast";
import RecentForm from "@/components/ui/RecentForm.tsx";
import PerformanceStats from "@/components/ui/PerformanceStats.tsx";
import MyChampionshipCard from "@/components/ui/MyChampionshipCard.tsx";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { type SearchMatchesRequest } from "@/services/api";
import {
	distinctGroupMatchSearchDtos,
	getApi,
	getRequestParams,
	type ChampionshipAndGroupDto,
	AuthenticationError,
} from "@/services/utils";
import { Cog8ToothIcon, PlusIcon, QueueListIcon, TrophyIcon, UserIcon } from "@heroicons/react/24/outline";
import { getSession } from "auth-astro/server";
const session = await getSession(Astro.request);

const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let championshipsAndGroups: ChampionshipAndGroupDto[] = [];

try {
	const searchMatchesRequest: SearchMatchesRequest = {
		UserId: session?.user?.id || "",
	};
	const standingsResponse = await api.api.padelmastersApiDomainEndpointsMatchesSearchMatches(
		searchMatchesRequest,
		getRequestParams(session)
	);
	if (standingsResponse.ok) {
		const championships = standingsResponse.data || [];
		championshipsAndGroups = distinctGroupMatchSearchDtos(championships);
	} else {
		// 404
		Astro.redirect("/not-found");
	}
} catch (e) {
	if (e instanceof AuthenticationError) {
		// Authentication failed, redirect to home page
		return Astro.redirect("/");
	}
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}

// Mock data for development - TODO: Replace with real API data
const mockRecentMatches = [
	{ id: "1", result: "win" as const, opponent: "Carlos M.", score: "6-4, 6-2", date: "2024-01-28", tournament: "Liga Primavera" },
	{ id: "2", result: "win" as const, opponent: "Ana L.", score: "6-3, 7-5", date: "2024-01-25", tournament: "Copa Invierno" },
	{ id: "3", result: "loss" as const, opponent: "Miguel R.", score: "4-6, 3-6", date: "2024-01-22" },
	{ id: "4", result: "win" as const, opponent: "Laura S.", score: "6-2, 6-4", date: "2024-01-20", tournament: "Liga Primavera" },
	{ id: "5", result: "win" as const, opponent: "Pedro G.", score: "7-6, 6-3", date: "2024-01-18" },
	{ id: "6", result: "loss" as const, opponent: "Maria C.", score: "2-6, 4-6", date: "2024-01-15", tournament: "Copa Invierno" },
	{ id: "7", result: "win" as const, opponent: "Jose A.", score: "6-4, 6-1", date: "2024-01-12" },
	{ id: "8", result: "win" as const, opponent: "Elena P.", score: "6-3, 6-2", date: "2024-01-10", tournament: "Liga Primavera" },
	{ id: "9", result: "win" as const, opponent: "Roberto D.", score: "7-5, 6-4", date: "2024-01-08" },
	{ id: "10", result: "loss" as const, opponent: "Sofia M.", score: "3-6, 5-7", date: "2024-01-05", tournament: "Copa Invierno" }
];

const mockCurrentStreak = { type: "win" as const, count: 2 };
const mockPerformanceStats = {
	winPercentage: 72,
	matchesThisMonth: 8,
	bestStreak: 5,
	currentRanking: 12,
	totalPlayers: 156
};

// Enhanced mock data for championships with player statistics
const mockChampionshipsWithStats = [
	{
		id: "1",
		name: "Liga Primavera 2024",
		groupId: "A1",
		groupName: "Grupo A",
		status: "Started" as const,
		startDate: "2024-01-15",
		endDate: "2024-03-15",
		stats: {
			played: 8,
			won: 6,
			lost: 1,
			draws: 1,
			pending: 4,
			winPercentage: 75,
			position: 2,
			totalParticipants: 12
		}
	},
	{
		id: "2",
		name: "Copa de Invierno",
		groupId: "B2",
		groupName: "Grupo B",
		status: "Started" as const,
		startDate: "2024-01-01",
		endDate: "2024-02-28",
		stats: {
			played: 5,
			won: 3,
			lost: 2,
			draws: 0,
			pending: 3,
			winPercentage: 60,
			position: 4,
			totalParticipants: 10
		}
	},
	{
		id: "3",
		name: "Torneo Navideño 2023",
		groupId: "C1",
		groupName: "Grupo Élite",
		status: "Finished" as const,
		startDate: "2023-12-01",
		endDate: "2023-12-31",
		stats: {
			played: 10,
			won: 7,
			lost: 2,
			draws: 1,
			pending: 0,
			winPercentage: 80,
			position: 1,
			totalParticipants: 16
		}
	}
];

// Mock data for next match
const mockNextMatch = {
	team1Player1: "Carlos M.",
	team1Player1Flag: "🇪🇸",
	team1Player2: "Pedro G.",
	team1Player2Flag: "🇪🇸",
	team2Player1: "Ana L.",
	team2Player1Flag: "🇫🇷",
	team2Player2: "María C.",
	team2Player2Flag: "🇫🇷",
	date: "2024-02-05",
	time: "18:30",
	tournament: "Liga Primavera 2024"
};
---

<section class="relative w-full min-h-screen bg-gradient-to-br from-blue-900 via-blue-950 to-slate-900">
	<!-- Gradient Overlay for depth -->
	<div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/40 to-black/60"></div>
	<div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent"></div>

	<!-- Content -->
	<div class="relative z-10 pt-32 md:pt-24 px-6 pb-[26rem] md:pb-40">
		<!-- Profile Header with Glassmorphism -->
		<div class="bg-white/10 backdrop-blur-md border border-white/20 rounded-xl p-6 mb-6 shadow-2xl">
			<div class="flex flex-col md:flex-row items-center justify-between gap-6">
				<!-- User Info Section -->
				<div class="flex items-center gap-4">
					<UserIcon className="h-6 w-6 text-white" />
					<div class="flex flex-col">
						<h2 class="text-2xl font-bold text-white">{session?.user?.name}</h2>
						<span class="text-sm text-white/70">Welcome back to Padel Masters</span>
					</div>
				</div>

				<!-- Action Buttons Section -->
				<div class="flex flex-col sm:flex-row items-center gap-4">
					<a
						href="/profile/edit"
						class="flex items-center gap-2 rounded-lg bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-2 text-sm font-medium text-white/90 transition-all duration-300 hover:bg-white/20 hover:border-white/30 hover:scale-105 shadow-lg"
					>
						<Cog8ToothIcon className="h-4 w-4" />
						{t(TranslationKey.AccounSettings)}
					</a>
					<div>
						<SignOutComponent client:load text={t(TranslationKey.SignOut)} />
					</div>
				</div>
			</div>
		</div>

		<!-- Performance Cards Section -->
		<div class="max-w-7xl mx-auto mb-6">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<!-- Left Column - Recent Form with Next Match -->
				<RecentForm 
					matches={mockRecentMatches} 
					currentStreak={mockCurrentStreak}
					nextMatch={mockNextMatch}
					client:load 
				/>
				
				<!-- Right Column - Performance Stats -->
				<PerformanceStats 
					winPercentage={mockPerformanceStats.winPercentage}
					matchesThisMonth={mockPerformanceStats.matchesThisMonth}
					bestStreak={mockPerformanceStats.bestStreak}
					currentRanking={mockPerformanceStats.currentRanking}
					totalPlayers={mockPerformanceStats.totalPlayers}
					client:load 
				/>
			</div>
		</div>

		<!-- Championships Section -->
		<div class="max-w-7xl mx-auto">
			<!-- Always show the enhanced championships section with mock data for demo -->
			<div class="w-full rounded-xl bg-white/10 backdrop-blur-md border border-white/20 shadow-2xl">
				<!-- Header Section -->
				<div class="p-6">
					<div class="flex items-center gap-3 mb-4">
						<TrophyIcon className="h-6 w-6 text-white" />
						<div class="flex-1">
							<h3 class="text-base sm:text-lg font-semibold text-white">
								{t(TranslationKey.MyChampionships)}
							</h3>
							<p class="text-sm text-white/80">Estadísticas detalladas de tu participación en torneos</p>
						</div>
					</div>
					
					<!-- Separator -->
					<div class="border-b border-white/20 mb-4"></div>
				</div>

				<!-- Enhanced Championships List -->
				<div class="px-6 pb-6">
					<div>
						{mockChampionshipsWithStats.map((championship) => (
							<MyChampionshipCard 
								id={championship.id}
								name={championship.name}
								groupId={championship.groupId}
								groupName={championship.groupName}
								status={championship.status}
								startDate={championship.startDate}
								endDate={championship.endDate}
								stats={championship.stats}
								client:load
							/>
						))}
					</div>
				</div>
			</div>

			{/* Fallback for when no real data and no mock data */}
			{
				(!championshipsAndGroups || championshipsAndGroups.length === 0) && mockChampionshipsWithStats.length === 0 && (
					<div class="w-full rounded-xl bg-white/10 backdrop-blur-md border border-white/20 p-8 text-center shadow-2xl">
						<div class="flex flex-col items-center gap-4">
							<div class="flex h-16 w-16 items-center justify-center rounded-full bg-white/20 border border-white/30">
								<QueueListIcon className="h-8 w-8 text-white/80" />
							</div>
							<div>
								<h3 class="text-lg font-semibold text-white">
									{t(TranslationKey.NoChampionshipsTitle)}
								</h3>
								<p class="mt-2 text-sm text-white/70">{t(TranslationKey.NoChampionshipsDescription)}</p>
							</div>
							<div class="mt-4">
								<a
									href="/championships"
									class="inline-flex items-center gap-2 rounded-lg bg-[#1F3851] text-white px-4 py-2 text-sm font-semibold shadow-lg transition-all duration-300 hover:bg-[#152F47] hover:scale-105"
								>
									<PlusIcon className="h-4 w-4" />
									{t(TranslationKey.FindChampionship)}
								</a>
							</div>
						</div>
					</div>
				)
			}
		</div>
	</div>

	<!-- Integrated Footer Section - Full Width -->
	<div class="absolute bottom-0 left-0 right-0 z-10 w-full py-6">
		<!-- Features Section -->
		<div class="flex flex-col md:flex-row items-center justify-center gap-6 mb-6 px-6">
			<div class="flex items-center gap-2 text-sm text-white/70">
				<span>👤</span>
				<span class="hidden sm:inline">Personal Statistics</span>
				<span class="sm:hidden">Statistics</span>
			</div>
			<div class="flex items-center gap-2 text-sm text-white/70">
				<span>🏆</span>
				<span class="hidden sm:inline">Tournament Progress</span>
				<span class="sm:hidden">Progress</span>
			</div>
			<div class="flex items-center gap-2 text-sm text-white/70">
				<span>📊</span>
				<span class="hidden sm:inline">Match History</span>
				<span class="sm:hidden">History</span>
			</div>
		</div>

		<!-- Divider -->
		<div class="border-t border-white/20 mb-4 mx-6"></div>

		<!-- Bottom Section -->
		<div class="flex flex-col md:flex-row items-center justify-between gap-4 px-6">
			<!-- Copyright -->
			<div class="flex flex-col items-center md:items-start gap-2">
				<p class="text-sm text-white/70">
					© {new Date().getFullYear()} Padel Masters. All rights reserved.
				</p>
				<div class="flex items-center gap-4 text-xs text-white/60">
					<span>Made with ❤️ for padel lovers</span>
				</div>
			</div>

			<!-- Version Info -->
			<div class="flex items-center gap-2 text-xs text-white/60">
				<span>Version 2.0</span>
			</div>
		</div>
	</div>

	{errorMessage && <Toast message={errorMessage} type="error" client:load />}
</section>
