---
import SignOutComponent from "@/components/ui/SignOut.tsx";
import Toast from "@/components/ui/Toast";
import { getStatusClass } from "@/components/ui/utils";
import { TranslationKey } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { type SearchMatchesRequest } from "@/services/api";
import {
	distinctGroupMatchSearchDtos,
	getApi,
	getRequestParams,
	type ChampionshipAndGroupDto,
} from "@/services/utils";
import { Cog8ToothIcon, PlusIcon, QueueListIcon, TrophyIcon } from "@heroicons/react/24/outline";
import { UserCircleIcon } from "@heroicons/react/24/solid";
import { getSession } from "auth-astro/server";
const session = await getSession(Astro.request);

const t = useTranslations(session);

const api = getApi();
let errorMessage = "";

let championshipsAndGroups: ChampionshipAndGroupDto[] = [];

try {
	const searchMatchesRequest: SearchMatchesRequest = {
		UserId: session?.user?.id || "",
	};
	const standingsResponse = await api.api.padelmastersApiDomainEndpointsMatchesSearchMatches(
		searchMatchesRequest,
		getRequestParams(session)
	);
	if (standingsResponse.ok) {
		const championships = standingsResponse.data || [];
		championshipsAndGroups = distinctGroupMatchSearchDtos(championships);
	} else {
		// 404
		Astro.redirect("/not-found");
	}
	} catch (e) {
	console.error(e);
	errorMessage = t(TranslationKey.ErrorLoadingData);
}
---

<div class="w-full bg-[hsl(var(--page-background))] min-h-screen">
	<!-- Profile Header Card -->
	<div class="bg-primary-200 p-6 mb-6 border-b border-primary-800">
		<div class="flex flex-col md:flex-row items-center justify-between gap-6">
			<!-- User Info Section -->
			<div class="flex items-center gap-4">
				<div class="flex h-12 w-12 items-center justify-center rounded-lg bg-primary-200">
					<UserCircleIcon className="h-8 w-8 text-primary-600" />
				</div>
				<div class="flex flex-col">
					<h2 class="text-2xl font-bold text-primary-800">{session?.user?.name}</h2>
					<span class="text-sm text-primary-600">#Welcome back to Padel Masters</span>
				</div>
			</div>

			<!-- Action Buttons Section -->
			<div class="flex flex-col sm:flex-row items-center gap-4">
				<a
					href="/profile/edit"
					class="flex items-center gap-2 rounded-lg bg-white border border-primary-600 px-4 py-2 text-sm font-medium text-primary-700 transition-all duration-200 hover:bg-primary-50 hover:border-primary-700 hover:scale-105 shadow-lg"
				>
					<Cog8ToothIcon className="h-4 w-4" />
					{t(TranslationKey.AccounSettings)}
				</a>
				<div>
					<SignOutComponent client:load text={t(TranslationKey.SignOut)} />
				</div>
			</div>
		</div>
	</div>
</div>

<!-- Championships Section -->
<div class="w-full rounded-lg bg-white border border-gray-200">
	{
		(!championshipsAndGroups || championshipsAndGroups.length === 0) && (
			<div class="p-8 text-center">
				<div class="flex flex-col items-center gap-4">
					<div class="flex h-16 w-16 items-center justify-center rounded-full bg-neutral-100">
						<QueueListIcon className="h-8 w-8 text-neutral-400" />
					</div>
					<div>
						<h3 class="text-lg font-semibold text-gray-900">
							{t(TranslationKey.NoChampionshipsTitle)}
						</h3>
						<p class="mt-2 text-sm text-gray-500">{t(TranslationKey.NoChampionshipsDescription)}</p>
					</div>
					<div class="mt-4">
						<a
							href="/championships"
							class="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-primary-600 to-primary-700 px-4 py-2 text-sm font-semibold text-white shadow-lg transition-all duration-200 hover:from-primary-700 hover:to-primary-800 hover:scale-105"
						>
							<PlusIcon className="h-4 w-4" />
							{t(TranslationKey.FindChampionship)}
						</a>
					</div>
				</div>
			</div>
		)
	}

	{
		championshipsAndGroups.length > 0 && (
			<div class="p-6">
				<div class="mb-6">
					<div class="flex items-center gap-3 mb-2">
						<div class="flex h-8 w-8 items-center justify-center rounded-full bg-primary-100">
							<TrophyIcon className="h-5 w-5 text-primary-600" />
						</div>
						<h3 class="text-xl font-bold text-gray-900">{t(TranslationKey.MyChampionships)}</h3>
					</div>
					<p class="text-sm text-gray-500 ml-11">Manage and track your tournament participation</p>
				</div>
				<ul role="list" class="space-y-4">
					{championshipsAndGroups.map((championshipsAndGroup) => {
						return (
							<li class="rounded-lg border border-gray-200 bg-gray-50 p-4 hover:bg-gray-100 transition-colors duration-200">
								<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
									<div class="flex flex-col sm:flex-row sm:items-center gap-2">
										<a
											href={`/championships/${championshipsAndGroup.Championship?.Id}`}
											class="text-sm font-semibold text-primary-600 hover:text-primary-800 transition-colors underline decoration-primary-300 hover:decoration-primary-500"
										>
											{championshipsAndGroup.Championship?.Name}
										</a>
										<span class="hidden sm:inline text-gray-400">/</span>
										<a
											href={`/championships/${championshipsAndGroup.Championship?.Id}/${championshipsAndGroup.Group?.Id}/matches`}
											class="text-sm font-semibold text-primary-600 hover:text-primary-800 transition-colors underline decoration-primary-300 hover:decoration-primary-500"
										>
											{championshipsAndGroup.Group?.Name}
										</a>
									</div>
									<span
										class={`inline-flex items-center rounded-lg px-3 py-1 text-xs font-medium ${getStatusClass(championshipsAndGroup.Championship?.Status)}`}
									>
										{t(`Championships.Status.${championshipsAndGroup.Championship?.Status}`)}
									</span>
								</div>
							</li>
						);
					})}
				</ul>
			</div>
		)
	}
	{errorMessage && <Toast message={errorMessage} type="error" client:load />}
</div>
